#: src/dialog.c:93
msgid "Inspired by Windows 7"
msgstr "В стиле Windows 7"

#: src/dialog.c:94
msgid "Inspired by Windows 10"
msgstr "В стиле Windows 10"

#: src/dialog.c:95
msgid "Inspired by Windows 11"
msgstr "В стиле Windows 11"

#: src/dialog.c:96
msgid "Like the original Xfce button"
msgstr "Как стандартная кнопка Xfce"

#: src/dialog.c:98
msgid "Your own settings"
msgstr "Собственные настройки"

#: src/dialog.c:255
msgid "Detected: light panel"
msgstr "Обнаружено: светлая панель"

#: src/dialog.c:255
msgid "Detected: dark panel"
msgstr "Обнаружено: тёмная панель"

#: src/dialog.c:402
