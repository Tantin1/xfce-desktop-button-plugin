msgstr "_OK"

#. TRANSLATORS: entry in "Copy settings from another button";
#. * the first number is the panel, the second the plugin id
#: src/dialog.c:523
#, c-format
msgid "Panel %d — button #%d"
msgstr "Панель %d — кнопка №%d"

#: src/dialog.c:583 src/plugin.c:1084
#: src/xfce-desktop-button-plugin.desktop.in:4
msgid "Desktop Button"
msgstr "Кнопка рабочего стола"

#: src/dialog.c:585
msgid "_Close"
msgstr "_Закрыть"

#: src/dialog.c:601
msgid "Button"
msgstr "Кнопка"

#. TRANSLATORS: profile names. "Glass", "Strip" and "Minimal" are styles
#. * inspired by Windows 7, 10 and 11; translate them as short style names
#: src/dialog.c:608 src/plugin.c:1030
msgid "Custom"
msgstr "Свой"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Glass"
msgstr "Стекло"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Strip"
msgstr "Полоса"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Minimal"
msgstr "Минимальный"

#: src/dialog.c:609 src/plugin.c:1030
msgid "Classic icon"
msgstr "Классический значок"

#: src/dialog.c:610
msgid "_Profile:"
msgstr "_Профиль:"

#: src/dialog.c:617
msgid "Automatic"
msgstr "Автоматически"

#: src/dialog.c:617
msgid "Dark"
msgstr "Тёмный"

#: src/dialog.c:617
msgid "Light"
msgstr "Светлый"

#: src/dialog.c:619
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr ""
"Встроенные профили используют белый цвет на тёмных панелях и чёрный — на "
"светлых"

#: src/dialog.c:620
msgid "Panel t_one:"
msgstr "_Тон панели:"

#: src/dialog.c:629
msgid ""
"Width of the button along the panel. With the icon style it is the minimum "
"width: the button grows to fit the icon. In the middle of the panel, the "
"line styles use twice this width."
msgstr ""
"Ширина кнопки вдоль панели. В стиле значка это минимальная ширина: кнопка "
"расширяется, чтобы вместить значок. В середине панели стили с линией "
"используют двойную ширину."

#: src/dialog.c:632
msgid "Button _thickness (px):"
msgstr "Толщина _кнопки (пикс.):"

#: src/dialog.c:634 src/dialog.c:694 src/dialog.c:739
msgid "Line"
msgstr "Линия"

#: src/dialog.c:634 src/dialog.c:670
msgid "Icon"
msgstr "Значок"

#: src/dialog.c:634
msgid "None (background only)"
msgstr "Нет (только фон)"

#: src/dialog.c:635
msgid "_Style:"
msgstr "_Стиль:"

#: src/dialog.c:637
msgid "Use a single panel _row"
msgstr "Занимать один _ряд панели"

#: src/dialog.c:639
msgid ""
"On panels with more than one row, the button takes up only one row instead "
"of the full height of the panel"
msgstr ""
"На панелях с несколькими рядами кнопка занимает только один ряд, а не всю "
"высоту панели"

#: src/dialog.c:645
msgid ""
"Empty space between the button and the other items when the button is at one "
"end of the panel. It does not react to the mouse. In the middle of the panel "
"there is no gap: the button is twice as wide instead, with the line in the "
"center. With the glass shine, the button looks the same everywhere."
msgstr ""
"Пустое место между кнопкой и другими элементами, когда кнопка находится на "
"краю панели. Не реагирует на мышь. В середине панели отступа нет: вместо "
"этого кнопка вдвое шире, а линия — по центру. Со стеклянным блеском кнопка "
"везде выглядит одинаково."

#: src/dialog.c:650
msgid "Gap at the panel _ends (px):"
msgstr "_Отступ на краях панели (пикс.):"

#: src/dialog.c:651
msgid "General"
msgstr "Общие"

#: src/dialog.c:660
msgid "_Icon:"
msgstr "З_начок:"

#: src/dialog.c:664
msgid ""
"The button grows to fit the icon. The only limit is the height of the panel."
msgstr ""
"Кнопка расширяется, чтобы вместить значок. Единственное ограничение — высота "
"панели."

#: src/dialog.c:665
msgid "Icon si_ze (px):"
msgstr "Р_азмер значка (пикс.):"

#: src/dialog.c:667
msgid "_Follow the panel icon size"
msgstr "С_ледовать размеру значков панели"

#: src/dialog.c:680
msgid "Cop_y"
msgstr "Копиро_вать"

#: src/dialog.c:682
msgid "Replace all settings of this button with those of the selected one"
msgstr "Заменить все настройки этой кнопки настройками выбранной"

#: src/dialog.c:686
msgid "Fro_m:"
msgstr "_Из:"

#: src/dialog.c:690
msgid "Copy settings from another button"
msgstr "Копировать настройки другой кнопки"

#: src/dialog.c:700
msgid "Line _width (px):"
msgstr "_Толщина линии (пикс.):"

#. TRANSLATORS: unit of the line length: percent of the panel height, or pixels
#: src/dialog.c:707
#, no-c-format
msgid "% of panel"
msgstr "% панели"

#: src/dialog.c:707
msgid "px"
msgstr "пикс."

#: src/dialog.c:711
msgid "Line _length:"
msgstr "_Длина линии:"

#: src/dialog.c:717
msgid "Start (left / top)"
msgstr "Начало (слева / сверху)"

#: src/dialog.c:717
msgid "Center"
msgstr "Центр"

#: src/dialog.c:717
msgid "End (right / bottom)"
msgstr "Конец (справа / снизу)"

#: src/dialog.c:718
msgid "Automatic (depends on where the button is)"
msgstr "Автоматически (зависит от положения кнопки)"

#: src/dialog.c:720
msgid ""
"Automatic: at one end of the panel, the line faces the other items; in the "
"middle, it goes in the center."
msgstr ""
"Автоматически: на краю панели линия обращена к другим элементам; в середине "
"— по центру."

#: src/dialog.c:722
msgid "_Position:"
msgstr "_Положение:"

#: src/dialog.c:724
msgid "Always"
msgstr "Всегда"

#: src/dialog.c:724
msgid "Only on hover"
msgstr "Только при наведении"

#: src/dialog.c:725
msgid "_Visible:"
msgstr "_Видимость:"

#: src/dialog.c:728
msgid "C_olor:"
msgstr "_Цвет:"

#: src/dialog.c:731
msgid "Color on _hover:"
msgstr "Цвет при _наведении:"

#: src/dialog.c:734
msgid "Color when p_ressed:"
msgstr "Цвет при н_ажатии:"

#: src/dialog.c:736
msgid "Rounded _ends"
msgstr "_Скруглённые концы"

#: src/dialog.c:743
msgid "Background"
msgstr "Фон"

#: src/dialog.c:749
msgid "_Normal:"
msgstr "_Обычный:"

#: src/dialog.c:752
msgid "On h_over:"
msgstr "При н_аведении:"

#: src/dialog.c:755
msgid "_Pressed:"
msgstr "_Нажатие:"

#: src/dialog.c:758
msgid "Corner _radius (px):"
msgstr "_Радиус углов (пикс.):"

#: src/dialog.c:764
msgid "Small"
msgstr "Маленький"

#: src/dialog.c:765
msgid "Full"
msgstr "Полный"

#: src/dialog.c:768
msgid "How much of the button the colored background covers"
msgstr "Какую часть кнопки занимает цветной фон"

#: src/dialog.c:769
msgid "_Size:"
msgstr "Раз_мер:"

#: src/dialog.c:771
msgid "_Glass shine"
msgstr "_Стеклянный блеск"

#: src/dialog.c:775
msgid "_Keep the pressed color while the desktop is shown"
msgstr "Сохранять _цвет нажатия, пока показан рабочий стол"

#: src/dialog.c:778
msgid "Background colors"
msgstr "Цвета фона"

#: src/dialog.c:783
msgid "Smooth _transitions"
msgstr "_Плавные переходы"

#: src/dialog.c:785
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Плавно менять цвета при наведении и нажатии вместо мгновенного переключения"

#: src/dialog.c:788
msgid "Fast"
msgstr "Быстро"

#: src/dialog.c:788
msgid "Normal"
msgstr "Обычно"

#: src/dialog.c:788
msgid "Slow"
msgstr "Медленно"

#: src/dialog.c:789
msgid "Spee_d:"
msgstr "С_корость:"

#: src/dialog.c:791
msgid "Animations are disabled in the system settings."
msgstr "Анимация отключена в настройках системы."

#: src/dialog.c:798
msgid "Animation"
msgstr "Анимация"

#: src/dialog.c:801
msgid "Behavior"
msgstr "Поведение"

#: src/dialog.c:805 src/dialog.c:817
msgid "Do nothing"
msgstr "Ничего не делать"

#: src/dialog.c:805
msgid "Show / restore desktop"
msgstr "Показать / восстановить рабочий стол"

#: src/dialog.c:806
msgid "Minimize all windows"
msgstr "Свернуть все окна"

#: src/dialog.c:807
msgid "Shade / unshade windows (X11 only)"
msgstr "Свернуть / развернуть окна в заголовок (только X11)"

#: src/dialog.c:808
msgid "_Middle click:"
msgstr "_Средняя кнопка:"

#: src/dialog.c:810
msgid "Window shading is not supported on Wayland."
msgstr "Сворачивание окон в заголовок не поддерживается в Wayland."

#: src/dialog.c:817
msgid "Switch workspace"
msgstr "Переключить рабочее место"

#: src/dialog.c:818
msgid "Up shows desktop, down restores"
msgstr "Вверх — показать рабочий стол, вниз — восстановить"

#: src/dialog.c:819
msgid "Mouse _wheel:"
msgstr "_Колёсико мыши:"

#: src/dialog.c:821
msgid "Workspace switching is not available in this session."
msgstr "Переключение рабочих мест недоступно в этом сеансе."

#: src/dialog.c:828
msgid "Show desktop when _dragging a file over the button"
msgstr "Показывать рабочий стол при _перетаскивании файла на кнопку"

#: src/dialog.c:832
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Копировать _на рабочий стол файлы, брошенные на кнопку"

#: src/dialog.c:834
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo (2)."
"jpg\"."
msgstr ""
"Исходные файлы никогда не перемещаются и не удаляются, а существующие файлы "
"на рабочем столе никогда не перезаписываются: копия получает новое имя, "
"например «фото (2).jpg»."

#: src/dialog.c:838
msgid "Show _tooltip"
msgstr "П_оказывать подсказку"

#: src/dialog.c:841
msgid "Actions"
msgstr "Действия"

#: src/dialog.c:848
msgid "Show the desktop while the mouse is _over the button"
msgstr "Показывать _рабочий стол, пока указатель над кнопкой"

#: src/dialog.c:850
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep "
"the desktop visible."
msgstr ""
"Если убрать указатель, окна восстановятся. Щёлкните во время просмотра, "
"чтобы рабочий стол остался видимым."

#: src/dialog.c:855
msgid "D_elay (ms):"
msgstr "Задержка (_мс):"

#: src/dialog.c:857
msgid "Peek"
msgstr "Просмотр"

#: src/dialog.c:862
msgid ""
"Tip: place the button at one end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Совет: поместите кнопку на один из краёв панели и установите отступ панели "
"0, чтобы нажимать её, просто уводя указатель в угол экрана."

#: src/dialog.c:864
msgid "Keyboard shortcut command:"
msgstr "Команда для сочетания клавиш:"

#: src/plugin.c:302
msgid "Show desktop is not available in this session"
msgstr "Показ рабочего стола недоступен в этом сеансе"

#: src/plugin.c:304
msgid "Restore the minimized windows"
msgstr "Восстановить свёрнутые окна"

#: src/plugin.c:306
msgid "Minimize all open windows and show the desktop"
msgstr "Свернуть все открытые окна и показать рабочий стол"

#: src/plugin.c:312
msgid "Show Desktop"
msgstr "Показать рабочий стол"

#: src/plugin.c:1035
msgid "_Minimize all windows"
msgstr "_Свернуть все окна"

#: src/plugin.c:1041
msgid "S_hade / unshade windows"
msgstr "Свернуть / _развернуть окна в заголовок"

#: src/plugin.c:1057
msgid "_Profile"
msgstr "_Профиль"

#: src/plugin.c:1086
msgid "A slim, customizable Show Desktop button"
msgstr "Тонкая настраиваемая кнопка «Показать рабочий стол»"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "Тонкая настраиваемая кнопка «Показать рабочий стол»"
