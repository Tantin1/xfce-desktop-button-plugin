#: src/dialog.c:73
msgid "Inspired by Windows 7"
msgstr "Ispirato a Windows 7"

#: src/dialog.c:74
msgid "Inspired by Windows 10"
msgstr "Ispirato a Windows 10"

#: src/dialog.c:75
msgid "Inspired by Windows 11"
msgstr "Ispirato a Windows 11"

#: src/dialog.c:76
msgid "Like the original Xfce button"
msgstr "Come il pulsante originale di Xfce"

#: src/dialog.c:78
msgid "Your own settings"
msgstr "Impostazioni personali"

#: src/dialog.c:219
msgid "Detected: light panel"
msgstr "Rilevato: pannello chiaro"

#: src/dialog.c:219
msgid "Detected: dark panel"
msgstr "Rilevato: pannello scuro"

#. TRANSLATORS: entry in "Copy settings from another button";
#. * the first number is the panel, the second the plugin id
#: src/dialog.c:448
#, c-format
msgid "Panel %d — button #%d"
msgstr "Pannello %d — pulsante n. %d"

#: src/dialog.c:508 src/plugin.c:988
#: src/xfce-desktop-button-plugin.desktop.in:4
msgid "Desktop Button"
msgstr "Pulsante Scrivania"

#: src/dialog.c:510
msgid "_Close"
msgstr "_Chiudi"

#: src/dialog.c:526
msgid "Button"
msgstr "Pulsante"

#. TRANSLATORS: profile names. "Glass", "Strip" and "Minimal" are styles
#. * inspired by Windows 7, 10 and 11; translate them as short style names
#: src/dialog.c:533 src/plugin.c:934
msgid "Custom"
msgstr "Personalizzato"

#: src/dialog.c:533 src/plugin.c:934
msgid "Glass"
msgstr "Vetro"

#: src/dialog.c:533 src/plugin.c:934
msgid "Strip"
msgstr "Striscia"

#: src/dialog.c:533 src/plugin.c:934
msgid "Minimal"
msgstr "Minimale"

#: src/dialog.c:534 src/plugin.c:934
msgid "Classic icon"
msgstr "Icona classica"

#: src/dialog.c:535
msgid "_Profile:"
msgstr "_Profilo:"

#: src/dialog.c:542
msgid "Automatic"
msgstr "Automatico"

#: src/dialog.c:542
msgid "Dark"
msgstr "Scuro"

#: src/dialog.c:542
msgid "Light"
msgstr "Chiaro"

#: src/dialog.c:544
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr ""
"I profili predefiniti usano il bianco sui pannelli scuri e il nero su quelli "
"chiari"

#: src/dialog.c:545
msgid "Panel t_one:"
msgstr "_Tonalità del pannello:"

#: src/dialog.c:553
msgid "Button _thickness (px):"
msgstr "_Spessore del pulsante (px):"

#: src/dialog.c:555 src/dialog.c:602 src/dialog.c:642
msgid "Line"
msgstr "Linea"

#: src/dialog.c:555 src/dialog.c:578
msgid "Icon"
msgstr "Icona"

#: src/dialog.c:555
msgid "None (background only)"
msgstr "Nessuno (solo sfondo)"

#: src/dialog.c:556
msgid "_Style:"
msgstr "_Stile:"

#: src/dialog.c:558
msgid "Use a single panel _row"
msgstr "Usa una sola _riga del pannello"

#: src/dialog.c:560
msgid ""
"On panels with more than one row, the button takes up only one row instead of"
" the full height of the panel"
msgstr ""
"Nei pannelli con più righe, il pulsante occupa una sola riga invece "
"dell'intera altezza del pannello"

#: src/dialog.c:563
msgid "General"
msgstr "Generale"

#: src/dialog.c:570
msgid "Icon _name:"
msgstr "_Nome dell'icona:"

#: src/dialog.c:573
msgid "Icon si_ze (px):"
msgstr "_Dimensione dell'icona (px):"

#: src/dialog.c:575
msgid "_Follow the panel icon size"
msgstr "_Segui la dimensione delle icone del pannello"

#: src/dialog.c:588
msgid "C_opy"
msgstr "C_opia"

#: src/dialog.c:590
msgid "Replace all settings of this button with those of the selected one"
msgstr ""
"Sostituisce tutte le impostazioni di questo pulsante con quelle del pulsante "
"selezionato"

#: src/dialog.c:594
msgid "_From:"
msgstr "_Da:"

#: src/dialog.c:598
msgid "Copy settings from another button"
msgstr "Copia le impostazioni da un altro pulsante"

#: src/dialog.c:608
msgid "Line _width (px):"
msgstr "_Spessore della linea (px):"

#. TRANSLATORS: unit of the line length: percent of the panel height, or pixels
#: src/dialog.c:615
#, no-c-format
msgid "% of panel"
msgstr "% del pannello"

#: src/dialog.c:615
msgid "px"
msgstr "px"

#: src/dialog.c:619
msgid "Line _length:"
msgstr "_Lunghezza della linea:"

#: src/dialog.c:624
msgid "Start (left / top)"
msgstr "Inizio (sinistra / alto)"

#: src/dialog.c:624
msgid "Center"
msgstr "Centro"

#: src/dialog.c:624
msgid "End (right / bottom)"
msgstr "Fine (destra / basso)"

#: src/dialog.c:625
msgid "_Position:"
msgstr "_Posizione:"

#: src/dialog.c:627
msgid "Always"
msgstr "Sempre"

#: src/dialog.c:627
msgid "Only on hover"
msgstr "Solo al passaggio del mouse"

#: src/dialog.c:628
msgid "_Visible:"
msgstr "_Visibile:"

#: src/dialog.c:631
msgid "_Color:"
msgstr "_Colore:"

#: src/dialog.c:634
msgid "Color on _hover:"
msgstr "Colore al _passaggio:"

#: src/dialog.c:637
msgid "Color when p_ressed:"
msgstr "Colore alla p_ressione:"

#: src/dialog.c:639
msgid "R_ounded ends"
msgstr "Estremità a_rrotondate"

#: src/dialog.c:646
msgid "Background"
msgstr "Sfondo"

#: src/dialog.c:652
msgid "_Normal:"
msgstr "_Normale:"

#: src/dialog.c:655
msgid "On h_over:"
msgstr "Al pa_ssaggio:"

#: src/dialog.c:658
msgid "_Pressed:"
msgstr "_Premuto:"

#: src/dialog.c:661
msgid "Corner _radius (px):"
msgstr "_Raggio degli angoli (px):"

#: src/dialog.c:665
msgid "Empty space between the edge of the button and the colored background"
msgstr "Spazio vuoto tra il bordo del pulsante e lo sfondo colorato"

#: src/dialog.c:666
msgid "_Margin (px):"
msgstr "_Margine (px):"

#: src/dialog.c:668
msgid "_Glass shine"
msgstr "_Riflesso vetro"

#: src/dialog.c:672
msgid "_Keep the pressed color while the desktop is shown"
msgstr "_Mantieni il colore di pressione mentre è mostrata la scrivania"

#: src/dialog.c:675
msgid "Background colors"
msgstr "Colori di sfondo"

#: src/dialog.c:680
msgid "Smooth _transitions"
msgstr "_Transizioni fluide"

#: src/dialog.c:682
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Sfuma i colori al passaggio del mouse e al clic invece di cambiarli "
"all'istante"

#: src/dialog.c:685
msgid "Fast"
msgstr "Veloce"

#: src/dialog.c:685
msgid "Normal"
msgstr "Normale"

#: src/dialog.c:685
msgid "Slow"
msgstr "Lenta"

#: src/dialog.c:686
msgid "Spee_d:"
msgstr "_Velocità:"

#: src/dialog.c:688
msgid "Animations are disabled in the system settings."
msgstr "Le animazioni sono disattivate nelle impostazioni di sistema."

#: src/dialog.c:695
msgid "Animation"
msgstr "Animazione"

#: src/dialog.c:698
msgid "Behavior"
msgstr "Comportamento"

#: src/dialog.c:702 src/dialog.c:714
msgid "Do nothing"
msgstr "Non fare nulla"

#: src/dialog.c:702
msgid "Show / restore desktop"
msgstr "Mostra / ripristina la scrivania"

#: src/dialog.c:703
msgid "Minimize all windows"
msgstr "Minimizza tutte le finestre"

#: src/dialog.c:704
msgid "Shade / unshade windows (X11 only)"
msgstr "Arrotola / srotola finestre (solo X11)"

#: src/dialog.c:705
msgid "_Middle click:"
msgstr "Clic _centrale:"

#: src/dialog.c:707
msgid "Window shading is not supported on Wayland."
msgstr "L'arrotolamento delle finestre non è supportato su Wayland."

#: src/dialog.c:714
msgid "Switch workspace"
msgstr "Cambia area di lavoro"

#: src/dialog.c:715
msgid "Up shows desktop, down restores"
msgstr "Su mostra la scrivania, giù ripristina"

#: src/dialog.c:716
msgid "Mouse _wheel:"
msgstr "_Rotellina del mouse:"

#: src/dialog.c:718
msgid "Workspace switching is not available in this session."
msgstr "Il cambio di area di lavoro non è disponibile in questa sessione."

#: src/dialog.c:725
msgid "Show desktop when _dragging a file over the button"
msgstr "Mostra la scrivania _trascinando un file sul pulsante"

#: src/dialog.c:729
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Cop_ia sulla Scrivania i file rilasciati sul pulsante"

#: src/dialog.c:731
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo "
"(2).jpg\"."
msgstr ""
"I file originali non vengono mai spostati né eliminati e i file già presenti "
"sulla Scrivania non vengono mai sovrascritti: la copia riceve un nuovo nome, "
"come «foto (2).jpg»."

#: src/dialog.c:735
msgid "Show _tooltip"
msgstr "Mostra _suggerimento"

#: src/dialog.c:738
msgid "Actions"
msgstr "Azioni"

#: src/dialog.c:745
msgid "Show the desktop while the mouse is _over the button"
msgstr "Mostra la scrivania mentre il mouse è _sopra il pulsante"

#: src/dialog.c:747
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep the"
" desktop visible."
msgstr ""
"Allontanando il mouse le finestre vengono ripristinate. Fai clic durante "
"l'anteprima per mantenere visibile la scrivania."

#: src/dialog.c:752
msgid "D_elay (ms):"
msgstr "_Ritardo (ms):"

#: src/dialog.c:754
msgid "Peek"
msgstr "Anteprima"

#: src/dialog.c:759
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Suggerimento: posiziona il pulsante alla fine del pannello e imposta il "
"margine del pannello a 0 per poterlo cliccare spingendo il mouse nell'angolo "
"dello schermo."

#: src/dialog.c:761
msgid "Keyboard shortcut command:"
msgstr "Comando per una scorciatoia da tastiera:"

#: src/plugin.c:249
msgid "Show desktop is not available in this session"
msgstr "Mostrare la scrivania non è disponibile in questa sessione"

#: src/plugin.c:251
msgid "Restore the minimized windows"
msgstr "Ripristina le finestre minimizzate"

#: src/plugin.c:253
msgid "Minimize all open windows and show the desktop"
msgstr "Minimizza tutte le finestre aperte e mostra la scrivania"

#: src/plugin.c:259
msgid "Show Desktop"
msgstr "Mostra scrivania"

#: src/plugin.c:939
msgid "_Minimize all windows"
msgstr "_Minimizza tutte le finestre"

#: src/plugin.c:945
msgid "S_hade / unshade windows"
msgstr "_Arrotola / srotola finestre"

#: src/plugin.c:961
msgid "_Profile"
msgstr "_Profilo"

#: src/plugin.c:990
msgid "A slim, customizable Show Desktop button"
msgstr "Un pulsante «Mostra scrivania» sottile e personalizzabile"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "Pulsante «Mostra scrivania» sottile e personalizzabile"
