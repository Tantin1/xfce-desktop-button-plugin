#: src/dialog.c:619
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr ""
"Les profils intégrés utilisent du blanc sur les panneaux sombres et du noir "
"sur les panneaux clairs"

#: src/dialog.c:620
msgid "Panel t_one:"
msgstr "_Teinte du panneau :"

