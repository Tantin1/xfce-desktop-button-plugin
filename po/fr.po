msgstr "_Taille de l'icône (px) :"

#: src/dialog.c:660
msgid "_Follow the panel icon size"
msgstr "_Suivre la taille des icônes du panneau"

#: src/dialog.c:673
msgid "C_opy"
msgstr "C_opier"

#: src/dialog.c:675
msgid "Replace all settings of this button with those of the selected one"
msgstr ""
