msgstr "_Couleur :"

#: src/dialog.c:731
msgid "Color on _hover:"
msgstr "Couleur au _survol :"

#: src/dialog.c:734
msgid "Color when p_ressed:"
msgstr "Couleur à l'_appui :"

#: src/dialog.c:736
msgid "Rounded _ends"
msgstr "E_xtrémités arrondies"

#: src/dialog.c:743
msgid "Background"
msgstr "Fond"

