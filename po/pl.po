msgstr "_OK"

#. TRANSLATORS: entry in "Copy settings from another button";
#. * the first number is the panel, the second the plugin id
#: src/dialog.c:523
#, c-format
msgid "Panel %d — button #%d"
msgstr "Panel %d — przycisk nr %d"

#: src/dialog.c:583 src/plugin.c:1084
#: src/xfce-desktop-button-plugin.desktop.in:4
msgid "Desktop Button"
msgstr "Przycisk pulpitu"

#: src/dialog.c:585
msgid "_Close"
msgstr "Za_mknij"

#: src/dialog.c:601
msgid "Button"
msgstr "Przycisk"

#. TRANSLATORS: profile names. "Glass", "Strip" and "Minimal" are styles
#. * inspired by Windows 7, 10 and 11; translate them as short style names
#: src/dialog.c:608 src/plugin.c:1030
msgid "Custom"
msgstr "Własny"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Glass"
msgstr "Szkło"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Strip"
msgstr "Pasek"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Minimal"
msgstr "Minimalny"

#: src/dialog.c:609 src/plugin.c:1030
msgid "Classic icon"
msgstr "Klasyczna ikona"

#: src/dialog.c:610
msgid "_Profile:"
msgstr "_Profil:"

#: src/dialog.c:617
msgid "Automatic"
msgstr "Automatycznie"

#: src/dialog.c:617
msgid "Dark"
msgstr "Ciemny"

#: src/dialog.c:617
msgid "Light"
msgstr "Jasny"

#: src/dialog.c:619
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr ""
"Wbudowane profile używają bieli na ciemnych panelach i czerni na jasnych"

#: src/dialog.c:620
msgid "Panel t_one:"
msgstr "_Ton panelu:"

#: src/dialog.c:629
msgid ""
"Width of the button along the panel. With the icon style it is the minimum "
"width: the button grows to fit the icon. In the middle of the panel, the "
"line styles use twice this width."
msgstr ""
"Szerokość przycisku wzdłuż panelu. W stylu ikony to minimalna szerokość: "
"przycisk powiększa się, aby zmieścić ikonę. Na środku panelu style z linią "
"używają podwójnej szerokości."

#: src/dialog.c:632
msgid "Button _thickness (px):"
msgstr "_Grubość przycisku (px):"

#: src/dialog.c:634 src/dialog.c:694 src/dialog.c:739
msgid "Line"
msgstr "Linia"

#: src/dialog.c:634 src/dialog.c:670
msgid "Icon"
msgstr "Ikona"

#: src/dialog.c:634
msgid "None (background only)"
msgstr "Brak (tylko tło)"

#: src/dialog.c:635
msgid "_Style:"
msgstr "_Styl:"

#: src/dialog.c:637
msgid "Use a single panel _row"
msgstr "Używaj tylko jednego _rzędu panelu"

#: src/dialog.c:639
msgid ""
"On panels with more than one row, the button takes up only one row instead "
"of the full height of the panel"
msgstr ""
"W panelach z wieloma rzędami przycisk zajmuje tylko jeden rząd zamiast całej "
"wysokości panelu"

#: src/dialog.c:645
msgid ""
"Empty space between the button and the other items when the button is at one "
"end of the panel. It does not react to the mouse. In the middle of the panel "
"there is no gap: the button is twice as wide instead, with the line in the "
"center. With the glass shine, the button looks the same everywhere."
msgstr ""
"Pusta przestrzeń między przyciskiem a innymi elementami, gdy przycisk "
"znajduje się na końcu panelu. Nie reaguje na mysz. Na środku panelu nie ma "
"odstępu: zamiast tego przycisk jest dwa razy szerszy, z linią pośrodku. Z "
"połyskiem szkła przycisk wygląda wszędzie tak samo."

#: src/dialog.c:650
msgid "Gap at the panel _ends (px):"
msgstr "Odstęp na _końcach panelu (px):"

#: src/dialog.c:651
msgid "General"
msgstr "Ogólne"

#: src/dialog.c:660
msgid "_Icon:"
msgstr "_Ikona:"

#: src/dialog.c:664
msgid ""
"The button grows to fit the icon. The only limit is the height of the panel."
msgstr ""
"Przycisk powiększa się, aby zmieścić ikonę. Jedynym ograniczeniem jest "
"wysokość panelu."

#: src/dialog.c:665
msgid "Icon si_ze (px):"
msgstr "R_ozmiar ikony (px):"

#: src/dialog.c:667
msgid "_Follow the panel icon size"
msgstr "_Dopasuj do rozmiaru ikon panelu"

#: src/dialog.c:680
msgid "Cop_y"
msgstr "Skopi_uj"

#: src/dialog.c:682
msgid "Replace all settings of this button with those of the selected one"
msgstr "Zastępuje wszystkie ustawienia tego przycisku ustawieniami wybranego"

#: src/dialog.c:686
msgid "Fro_m:"
msgstr "_Z:"

#: src/dialog.c:690
msgid "Copy settings from another button"
msgstr "Kopiuj ustawienia z innego przycisku"

#: src/dialog.c:700
msgid "Line _width (px):"
msgstr "_Grubość linii (px):"

#. TRANSLATORS: unit of the line length: percent of the panel height, or pixels
#: src/dialog.c:707
#, no-c-format
msgid "% of panel"
msgstr "% panelu"

#: src/dialog.c:707
msgid "px"
msgstr "px"

#: src/dialog.c:711
msgid "Line _length:"
msgstr "_Długość linii:"

#: src/dialog.c:717
msgid "Start (left / top)"
msgstr "Początek (lewo / góra)"

#: src/dialog.c:717
msgid "Center"
msgstr "Środek"

#: src/dialog.c:717
msgid "End (right / bottom)"
msgstr "Koniec (prawo / dół)"

#: src/dialog.c:718
msgid "Automatic (depends on where the button is)"
msgstr "Automatycznie (zależnie od położenia przycisku)"

#: src/dialog.c:720
msgid ""
"Automatic: at one end of the panel, the line faces the other items; in the "
"middle, it goes in the center."
msgstr ""
"Automatycznie: na końcu panelu linia jest po stronie innych elementów; na "
"środku jest wyśrodkowana."

#: src/dialog.c:722
msgid "_Position:"
msgstr "_Położenie:"

#: src/dialog.c:724
msgid "Always"
msgstr "Zawsze"

#: src/dialog.c:724
msgid "Only on hover"
msgstr "Tylko po najechaniu"

#: src/dialog.c:725
msgid "_Visible:"
msgstr "_Widoczna:"

#: src/dialog.c:728
msgid "C_olor:"
msgstr "_Kolor:"

#: src/dialog.c:731
msgid "Color on _hover:"
msgstr "Kolor po _najechaniu:"

#: src/dialog.c:734
msgid "Color when p_ressed:"
msgstr "Kolor po n_aciśnięciu:"

#: src/dialog.c:736
msgid "Rounded _ends"
msgstr "_Zaokrąglone końce"

#: src/dialog.c:743
msgid "Background"
msgstr "Tło"

#: src/dialog.c:749
msgid "_Normal:"
msgstr "_Zwykły:"

#: src/dialog.c:752
msgid "On h_over:"
msgstr "Po _najechaniu:"

#: src/dialog.c:755
msgid "_Pressed:"
msgstr "_Wciśnięty:"

#: src/dialog.c:758
msgid "Corner _radius (px):"
msgstr "_Promień narożników (px):"

#: src/dialog.c:764
msgid "Small"
msgstr "Mały"

#: src/dialog.c:765
msgid "Full"
msgstr "Pełny"

#: src/dialog.c:768
msgid "How much of the button the colored background covers"
msgstr "Jaką część przycisku zakrywa kolorowe tło"

#: src/dialog.c:769
msgid "_Size:"
msgstr "_Rozmiar:"

#: src/dialog.c:771
msgid "_Glass shine"
msgstr "_Szklany połysk"

#: src/dialog.c:775
msgid "_Keep the pressed color while the desktop is shown"
msgstr "Zachowaj _kolor wciśnięcia, gdy pulpit jest widoczny"

#: src/dialog.c:778
msgid "Background colors"
msgstr "Kolory tła"

#: src/dialog.c:783
msgid "Smooth _transitions"
msgstr "P_łynne przejścia"

#: src/dialog.c:785
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Płynnie zmieniaj kolory po najechaniu i kliknięciu zamiast zmieniać je "
"natychmiast"

#: src/dialog.c:788
msgid "Fast"
msgstr "Szybko"

#: src/dialog.c:788
msgid "Normal"
msgstr "Normalnie"

#: src/dialog.c:788
msgid "Slow"
msgstr "Wolno"

#: src/dialog.c:789
msgid "Spee_d:"
msgstr "Pr_ędkość:"

#: src/dialog.c:791
msgid "Animations are disabled in the system settings."
msgstr "Animacje są wyłączone w ustawieniach systemu."

#: src/dialog.c:798
msgid "Animation"
msgstr "Animacja"

#: src/dialog.c:801
msgid "Behavior"
msgstr "Zachowanie"

#: src/dialog.c:805 src/dialog.c:817
msgid "Do nothing"
msgstr "Nic nie rób"

#: src/dialog.c:805
msgid "Show / restore desktop"
msgstr "Pokaż / przywróć pulpit"

#: src/dialog.c:806
msgid "Minimize all windows"
msgstr "Zminimalizuj wszystkie okna"

#: src/dialog.c:807
msgid "Shade / unshade windows (X11 only)"
msgstr "Zwiń / rozwiń okna (tylko X11)"

#: src/dialog.c:808
msgid "_Middle click:"
msgstr "Kliknięcie ś_rodkowym:"

#: src/dialog.c:810
msgid "Window shading is not supported on Wayland."
msgstr "Zwijanie okien nie jest obsługiwane w Wayland."

#: src/dialog.c:817
msgid "Switch workspace"
msgstr "Przełącz obszar roboczy"

#: src/dialog.c:818
msgid "Up shows desktop, down restores"
msgstr "W górę pokazuje pulpit, w dół przywraca"

#: src/dialog.c:819
msgid "Mouse _wheel:"
msgstr "_Kółko myszy:"

#: src/dialog.c:821
msgid "Workspace switching is not available in this session."
msgstr "Przełączanie obszarów roboczych nie jest dostępne w tej sesji."

#: src/dialog.c:828
msgid "Show desktop when _dragging a file over the button"
msgstr "Pokaż pulpit po _przeciągnięciu pliku nad przycisk"

#: src/dialog.c:832
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Kopiuj _na pulpit pliki upuszczone na przycisk"

#: src/dialog.c:834
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo (2)."
"jpg\"."
msgstr ""
"Pliki oryginalne nigdy nie są przenoszone ani usuwane, a istniejące pliki na "
"pulpicie nigdy nie są nadpisywane: kopia otrzymuje nową nazwę, np. „zdjęcie "
"(2).jpg”."

#: src/dialog.c:838
msgid "Show _tooltip"
msgstr "P_okaż podpowiedź"

#: src/dialog.c:841
msgid "Actions"
msgstr "Działania"

#: src/dialog.c:848
msgid "Show the desktop while the mouse is _over the button"
msgstr "Pokazuj pulpit, _gdy kursor jest nad przyciskiem"

#: src/dialog.c:850
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep "
"the desktop visible."
msgstr ""
"Odsunięcie kursora przywraca okna. Kliknij podczas podglądu, aby pulpit "
"pozostał widoczny."

#: src/dialog.c:855
msgid "D_elay (ms):"
msgstr "Op_óźnienie (ms):"

#: src/dialog.c:857
msgid "Peek"
msgstr "Podgląd"

#: src/dialog.c:862
msgid ""
"Tip: place the button at one end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Wskazówka: umieść przycisk na jednym z końców panelu i ustaw margines panelu "
"na 0, aby kliknąć go, przesuwając kursor do rogu ekranu."

#: src/dialog.c:864
msgid "Keyboard shortcut command:"
msgstr "Polecenie dla skrótu klawiszowego:"

#: src/plugin.c:302
msgid "Show desktop is not available in this session"
msgstr "Pokazywanie pulpitu nie jest dostępne w tej sesji"

#: src/plugin.c:304
msgid "Restore the minimized windows"
msgstr "Przywróć zminimalizowane okna"

#: src/plugin.c:306
msgid "Minimize all open windows and show the desktop"
msgstr "Zminimalizuj wszystkie otwarte okna i pokaż pulpit"

#: src/plugin.c:312
msgid "Show Desktop"
msgstr "Pokaż pulpit"

#: src/plugin.c:1035
msgid "_Minimize all windows"
msgstr "Z_minimalizuj wszystkie okna"

#: src/plugin.c:1041
msgid "S_hade / unshade windows"
msgstr "Zwiń / _rozwiń okna"

#: src/plugin.c:1057
msgid "_Profile"
msgstr "_Profil"

#: src/plugin.c:1086
msgid "A slim, customizable Show Desktop button"
msgstr "Wąski, konfigurowalny przycisk „Pokaż pulpit”"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "Wąski, konfigurowalny przycisk „Pokaż pulpit”"
