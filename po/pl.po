msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Płynnie zmieniaj kolory po najechaniu i kliknięciu zamiast zmieniać je "
"natychmiast"

#: src/dialog.c:687
msgid "Fast"
msgstr "Szybko"

#: src/dialog.c:687
msgid "Normal"
msgstr "Normalnie"

#: src/dialog.c:687
msgid "Slow"
msgstr "Wolno"

#: src/dialog.c:688
msgid "Spee_d:"
msgstr "Pręd_kość:"

#: src/dialog.c:690
msgid "Animations are disabled in the system settings."
msgstr "Animacje są wyłączone w ustawieniach systemu."

#: src/dialog.c:697
msgid "Animation"
msgstr "Animacja"

#: src/dialog.c:700
msgid "Behavior"
msgstr "Zachowanie"

#: src/dialog.c:704 src/dialog.c:716
msgid "Do nothing"
msgstr "Nic nie rób"

#: src/dialog.c:704
msgid "Show / restore desktop"
msgstr "Pokaż / przywróć pulpit"

#: src/dialog.c:705
msgid "Minimize all windows"
msgstr "Zminimalizuj wszystkie okna"

#: src/dialog.c:706
msgid "Shade / unshade windows (X11 only)"
msgstr "Zwiń / rozwiń okna (tylko X11)"

#: src/dialog.c:707
msgid "_Middle click:"
msgstr "Kliknięcie ś_rodkowym:"

#: src/dialog.c:709
msgid "Window shading is not supported on Wayland."
msgstr "Zwijanie okien nie jest obsługiwane w Wayland."

#: src/dialog.c:716
msgid "Switch workspace"
msgstr "Przełącz obszar roboczy"

#: src/dialog.c:717
msgid "Up shows desktop, down restores"
msgstr "W górę pokazuje pulpit, w dół przywraca"

#: src/dialog.c:718
msgid "Mouse _wheel:"
msgstr "Kółko _myszy:"

#: src/dialog.c:720
msgid "Workspace switching is not available in this session."
msgstr "Przełączanie obszarów roboczych nie jest dostępne w tej sesji."

#: src/dialog.c:727
msgid "Show desktop when _dragging a file over the button"
msgstr "Pokaż pulpit po _przeciągnięciu pliku nad przycisk"

#: src/dialog.c:731
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "_Kopiuj na pulpit pliki upuszczone na przycisk"

#: src/dialog.c:733
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo (2)."
"jpg\"."
msgstr ""
"Pliki oryginalne nigdy nie są przenoszone ani usuwane, a istniejące pliki na "
"pulpicie nigdy nie są nadpisywane: kopia otrzymuje nową nazwę, np. „zdjęcie "
"(2).jpg”."

#: src/dialog.c:737
msgid "Show _tooltip"
msgstr "Pokaż _podpowiedź"

#: src/dialog.c:740
msgid "Actions"
msgstr "Działania"

#: src/dialog.c:747
msgid "Show the desktop while the mouse is _over the button"
msgstr "Pokazuj pulpit, gdy kursor jest _nad przyciskiem"

#: src/dialog.c:749
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep "
"the desktop visible."
msgstr ""
"Odsunięcie kursora przywraca okna. Kliknij podczas podglądu, aby pulpit "
"pozostał widoczny."

#: src/dialog.c:754
msgid "D_elay (ms):"
msgstr "_Opóźnienie (ms):"

#: src/dialog.c:756
msgid "Peek"
msgstr "Podgląd"

#: src/dialog.c:761
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Wskazówka: umieść przycisk na końcu panelu i ustaw margines panelu na 0, aby "
"kliknąć go, przesuwając kursor do rogu ekranu."

#: src/dialog.c:763
msgid "Keyboard shortcut command:"
msgstr "Polecenie dla skrótu klawiszowego:"

#: src/plugin.c:287
msgid "Show desktop is not available in this session"
msgstr "Pokazywanie pulpitu nie jest dostępne w tej sesji"

#: src/plugin.c:289
msgid "Restore the minimized windows"
msgstr "Przywróć zminimalizowane okna"

#: src/plugin.c:291
msgid "Minimize all open windows and show the desktop"
msgstr "Zminimalizuj wszystkie otwarte okna i pokaż pulpit"

#: src/plugin.c:297
msgid "Show Desktop"
msgstr "Pokaż pulpit"

#: src/plugin.c:1000
msgid "_Minimize all windows"
msgstr "Z_minimalizuj wszystkie okna"

#: src/plugin.c:1006
msgid "S_hade / unshade windows"
