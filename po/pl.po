msgid "Background colors"
msgstr "Kolory tła"

#: src/dialog.c:773
msgid "Smooth _transitions"
msgstr "Płynne _przejścia"

#: src/dialog.c:775
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Płynnie zmieniaj kolory po najechaniu i kliknięciu zamiast zmieniać je "
"natychmiast"

#: src/dialog.c:778
msgid "Fast"
msgstr "Szybko"

