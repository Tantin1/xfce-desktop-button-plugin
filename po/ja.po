msgstr "Windows 10 風"

#: src/dialog.c:95
msgid "Inspired by Windows 11"
msgstr "Windows 11 風"

#: src/dialog.c:96
msgid "Like the original Xfce button"
msgstr "Xfce 標準のボタンと同様"

#: src/dialog.c:98
msgid "Your own settings"
msgstr "独自の設定"

#: src/dialog.c:255
msgid "Detected: light panel"
msgstr "検出結果: 明るいパネル"

#: src/dialog.c:255
