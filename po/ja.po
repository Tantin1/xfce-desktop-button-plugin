msgid "Line"
msgstr "ライン"

#: src/dialog.c:630 src/dialog.c:663
msgid "Icon"
msgstr "アイコン"

#: src/dialog.c:630
msgid "None (background only)"
msgstr "なし (背景のみ)"

#: src/dialog.c:631
msgid "_Style:"
msgstr "スタイル(_S):"

#: src/dialog.c:633
msgid "Use a single panel _row"
msgstr "パネルの 1 行だけを使う(_R)"

#: src/dialog.c:635
msgid ""
"On panels with more than one row, the button takes up only one row instead "
"of the full height of the panel"
msgstr "複数行のパネルでは、パネルの高さ全体ではなく 1 行分だけを使います"

#: src/dialog.c:641
msgid ""
"Empty space between the button and the other items when the button is at one "
"end of the panel. It does not react to the mouse. In the middle of the panel "
"there is no gap: the button is twice as wide, with the line in the center."
msgstr ""
"ボタンがパネルの端にあるときの、ボタンと他の項目の間の空白です。マウスには反"
"応しません。パネルの中央では空白はなく、ボタンの幅が2倍になり、線が中央に表示"
"されます。"

#: src/dialog.c:645
msgid "Gap at the panel _ends (px):"
msgstr "パネル端の間隔 (px)(_E):"

#: src/dialog.c:646
msgid "General"
msgstr "全般"

#: src/dialog.c:655
msgid "_Icon:"
msgstr "アイコン(_I):"

#: src/dialog.c:658
msgid "Icon si_ze (px):"
msgstr "アイコンサイズ(_Z) (px):"

#: src/dialog.c:660
msgid "_Follow the panel icon size"
msgstr "パネルのアイコンサイズに合わせる(_F)"

#: src/dialog.c:673
msgid "C_opy"
msgstr "コピー(_O)"

#: src/dialog.c:675
msgid "Replace all settings of this button with those of the selected one"
msgstr "このボタンのすべての設定を、選択したボタンの設定で置き換えます"

#: src/dialog.c:679
msgid "_From:"
msgstr "コピー元(_F):"

#: src/dialog.c:683
msgid "Copy settings from another button"
msgstr "他のボタンから設定をコピー"

#: src/dialog.c:693
msgid "Line _width (px):"
msgstr "線の太さ(_W) (px):"

#. TRANSLATORS: unit of the line length: percent of the panel height, or pixels
