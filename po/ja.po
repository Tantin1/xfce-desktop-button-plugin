msgstr "ダーク"

#: src/dialog.c:617
msgid "Light"
msgstr "ライト"

#: src/dialog.c:619
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr "組み込みプロファイルは、暗いパネルでは白、明るいパネルでは黒を使います"

#: src/dialog.c:620
msgid "Panel t_one:"
msgstr "パネルの色調(_O):"

#: src/dialog.c:628
msgid "Button _thickness (px):"
msgstr "ボタンの太さ(_T) (px):"

