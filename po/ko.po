msgid "_Style:"
msgstr "스타일(_S):"

#: src/dialog.c:558
msgid "Use a single panel _row"
msgstr "패널의 한 줄만 사용(_R)"

#: src/dialog.c:560
msgid ""
"On panels with more than one row, the button takes up only one row instead "
"of the full height of the panel"
msgstr "여러 줄로 된 패널에서 버튼이 패널 전체 높이 대신 한 줄만 차지합니다"

#: src/dialog.c:563
msgid "General"
