#: src/dialog.c:599
msgid "Line _width (px):"
msgstr "선 두께(_W) (px):"

#. TRANSLATORS: unit of the line length: percent of the panel height, or pixels
#: src/dialog.c:606
#, no-c-format
msgid "% of panel"
msgstr "패널의 %"

#: src/dialog.c:606
msgid "px"
msgstr "px"

#: src/dialog.c:610
msgid "Line _length:"
msgstr "선 길이(_L):"

#: src/dialog.c:615
msgid "Start (left / top)"
msgstr "시작 (왼쪽 / 위)"

#: src/dialog.c:615
msgid "Center"
msgstr "가운데"

#: src/dialog.c:615
msgid "End (right / bottom)"
msgstr "끝 (오른쪽 / 아래)"

#: src/dialog.c:616
msgid "_Position:"
msgstr "위치(_P):"

#: src/dialog.c:618
msgid "Always"
msgstr "항상"

#: src/dialog.c:618
msgid "Only on hover"
msgstr "마우스를 올릴 때만"

#: src/dialog.c:619
msgid "_Visible:"
msgstr "표시(_V):"

#: src/dialog.c:622
msgid "_Color:"
msgstr "색상(_C):"

#: src/dialog.c:625
msgid "Color on _hover:"
msgstr "마우스를 올렸을 때 색상(_H):"

#: src/dialog.c:628
msgid "Color when p_ressed:"
msgstr "눌렀을 때 색상(_R):"

#: src/dialog.c:630
msgid "R_ounded ends"
msgstr "끝을 둥글게(_O)"

#: src/dialog.c:637
msgid "Background"
msgstr "배경"

#: src/dialog.c:643
msgid "_Normal:"
msgstr "기본(_N):"

#: src/dialog.c:646
msgid "On h_over:"
msgstr "마우스를 올렸을 때(_O):"

#: src/dialog.c:649
msgid "_Pressed:"
msgstr "눌렀을 때(_P):"

#: src/dialog.c:652
msgid "Corner _radius (px):"
msgstr "모서리 반경(_R) (px):"

#: src/dialog.c:656
msgid "Empty space between the edge of the button and the colored background"
msgstr "버튼 가장자리와 색이 칠해진 배경 사이의 빈 공간"

#: src/dialog.c:657
msgid "_Margin (px):"
msgstr "여백(_M) (px):"

#: src/dialog.c:659
msgid "_Glass shine"
msgstr "유리 광택(_G)"

#: src/dialog.c:663
msgid "_Keep the pressed color while the desktop is shown"
msgstr "바탕 화면이 표시되는 동안 눌림 색상 유지(_K)"

#: src/dialog.c:666
msgid "Background colors"
msgstr "배경 색상"

#: src/dialog.c:671
msgid "Smooth _transitions"
msgstr "부드러운 전환(_T)"

#: src/dialog.c:673
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr "마우스를 올리거나 클릭할 때 색상을 즉시 바꾸지 않고 서서히 바꿉니다"

#: src/dialog.c:676
msgid "Fast"
msgstr "빠르게"

#: src/dialog.c:676
msgid "Normal"
msgstr "보통"

#: src/dialog.c:676
msgid "Slow"
msgstr "느리게"

#: src/dialog.c:677
msgid "Spee_d:"
msgstr "속도(_D):"

#: src/dialog.c:679
msgid "Animations are disabled in the system settings."
msgstr "시스템 설정에서 애니메이션이 꺼져 있습니다."

#: src/dialog.c:686
msgid "Animation"
msgstr "애니메이션"

#: src/dialog.c:689
msgid "Behavior"
msgstr "동작"

#: src/dialog.c:693 src/dialog.c:705
msgid "Do nothing"
msgstr "아무것도 안 함"

#: src/dialog.c:693
msgid "Show / restore desktop"
msgstr "바탕 화면 표시 / 복원"

#: src/dialog.c:694
msgid "Minimize all windows"
msgstr "모든 창 최소화"

#: src/dialog.c:695
msgid "Shade / unshade windows (X11 only)"
msgstr "창 말아 올리기 / 펼치기 (X11 전용)"

#: src/dialog.c:696
msgid "_Middle click:"
msgstr "가운데 클릭(_M):"

#: src/dialog.c:698
msgid "Window shading is not supported on Wayland."
msgstr "Wayland에서는 창 말아 올리기를 지원하지 않습니다."

#: src/dialog.c:705
msgid "Switch workspace"
msgstr "작업 공간 전환"

#: src/dialog.c:706
msgid "Up shows desktop, down restores"
msgstr "위로 바탕 화면 표시, 아래로 복원"

#: src/dialog.c:707
msgid "Mouse _wheel:"
msgstr "마우스 휠(_W):"

#: src/dialog.c:709
msgid "Workspace switching is not available in this session."
msgstr "이 세션에서는 작업 공간을 전환할 수 없습니다."

#: src/dialog.c:716
msgid "Show desktop when _dragging a file over the button"
msgstr "파일을 버튼 위로 끌면 바탕 화면 표시(_D)"

#: src/dialog.c:720
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "버튼에 놓은 파일을 바탕 화면에 복사(_Y)"

#: src/dialog.c:722
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo "
"(2).jpg\"."
msgstr ""
"원본 파일은 이동하거나 삭제하지 않으며, 바탕 화면에 있는 기존 파일을 덮어쓰지 않습니다. 복사본에는 \"photo (2).jpg\"와 "
"같은 새 이름이 붙습니다."

#: src/dialog.c:726
msgid "Show _tooltip"
msgstr "도구 설명 표시(_T)"

#: src/dialog.c:729
msgid "Actions"
msgstr "작업"

#: src/dialog.c:736
msgid "Show the desktop while the mouse is _over the button"
msgstr "마우스가 버튼 위에 있는 동안 바탕 화면 표시(_O)"

#: src/dialog.c:738
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep the"
" desktop visible."
msgstr "마우스를 치우면 창이 복원됩니다. 미리 보기 중에 클릭하면 바탕 화면이 계속 표시됩니다."

#: src/dialog.c:743
msgid "D_elay (ms):"
msgstr "지연(_E) (ms):"

#: src/dialog.c:745
msgid "Peek"
msgstr "미리 보기"

#: src/dialog.c:750
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr "팁: 버튼을 패널 끝에 두고 패널 여백을 0으로 설정하면 마우스를 화면 모서리로 밀어서 클릭할 수 있습니다."

#: src/dialog.c:752
msgid "Keyboard shortcut command:"
msgstr "키보드 단축키 명령:"

#: src/plugin.c:243
msgid "Show desktop is not available in this session"
msgstr "이 세션에서는 바탕 화면 표시를 사용할 수 없습니다"

#: src/plugin.c:245
msgid "Restore the minimized windows"
msgstr "최소화된 창 복원"

#: src/plugin.c:247
msgid "Minimize all open windows and show the desktop"
msgstr "열린 모든 창을 최소화하고 바탕 화면 표시"

#: src/plugin.c:253
msgid "Show Desktop"
msgstr "바탕 화면 보기"

#: src/plugin.c:933
msgid "_Minimize all windows"
msgstr "모든 창 최소화(_M)"

#: src/plugin.c:939
msgid "S_hade / unshade windows"
msgstr "창 말아 올리기 / 펼치기(_H)"

#: src/plugin.c:955
msgid "_Profile"
msgstr "프로필(_P)"

#: src/plugin.c:984
msgid "A slim, customizable Show Desktop button"
msgstr "얇고 사용자 지정 가능한 '바탕 화면 보기' 버튼"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "얇고 사용자 지정 가능한 '바탕 화면 보기' 버튼"
