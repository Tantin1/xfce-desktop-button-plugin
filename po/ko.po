#: src/dialog.c:615
#, no-c-format
msgid "% of panel"
msgstr "패널의 %"

#: src/dialog.c:615
msgid "px"
msgstr "px"

#: src/dialog.c:619
msgid "Line _length:"
msgstr "선 길이(_L):"

#: src/dialog.c:625
msgid "Start (left / top)"
msgstr "시작 (왼쪽 / 위)"

#: src/dialog.c:625
msgid "Center"
msgstr "가운데"

#: src/dialog.c:625
msgid "End (right / bottom)"
msgstr "끝 (오른쪽 / 아래)"

#: src/dialog.c:626
msgid "Automatic (toward the other panel items)"
msgstr "자동 (패널의 다른 항목 쪽)"

#: src/dialog.c:627
msgid "_Position:"
msgstr "위치(_P):"

#: src/dialog.c:629
