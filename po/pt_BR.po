#. TRANSLATORS: profile names. "Glass", "Strip" and "Minimal" are styles
#. * inspired by Windows 7, 10 and 11; translate them as short style names
#: src/dialog.c:608 src/plugin.c:1030
msgid "Custom"
msgstr "Personalizado"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Glass"
msgstr "Vidro"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Strip"
msgstr "Faixa"

#: src/dialog.c:608 src/plugin.c:1030
msgid "Minimal"
msgstr "Mínimo"

#: src/dialog.c:609 src/plugin.c:1030
msgid "Classic icon"
msgstr "Ícone clássico"

#: src/dialog.c:610
msgid "_Profile:"
msgstr "_Perfil:"

#: src/dialog.c:617
msgid "Automatic"
msgstr "Automático"

#: src/dialog.c:617
msgid "Dark"
msgstr "Escuro"

#: src/dialog.c:617
msgid "Light"
msgstr "Claro"

#: src/dialog.c:619
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr ""
"Os perfis predefinidos usam branco em painéis escuros e preto em painéis "
"claros"

#: src/dialog.c:620
msgid "Panel t_one:"
msgstr "_Tom do painel:"

#: src/dialog.c:629
msgid ""
"Width of the button along the panel. With the icon style it is the minimum "
"width: the button grows to fit the icon. In the middle of the panel, the "
"line styles use twice this width."
msgstr ""
"Largura do botão ao longo do painel. No estilo ícone é a largura mínima: o "
"botão aumenta para caber o ícone. No meio do painel, os estilos com linha "
"usam o dobro desta largura."

#: src/dialog.c:632
msgid "Button _thickness (px):"
msgstr "_Espessura do botão (px):"

#: src/dialog.c:634 src/dialog.c:694 src/dialog.c:739
msgid "Line"
msgstr "Linha"

#: src/dialog.c:634 src/dialog.c:670
msgid "Icon"
msgstr "Ícone"

#: src/dialog.c:634
msgid "None (background only)"
msgstr "Nenhum (apenas fundo)"

#: src/dialog.c:635
msgid "_Style:"
msgstr "E_stilo:"

#: src/dialog.c:637
msgid "Use a single panel _row"
msgstr "Usar uma única _linha do painel"

#: src/dialog.c:639
msgid ""
"On panels with more than one row, the button takes up only one row instead "
"of the full height of the panel"
msgstr ""
"Em painéis com mais de uma linha, o botão ocupa só uma linha em vez de toda "
"a altura do painel"

#: src/dialog.c:645
msgid ""
"Empty space between the button and the other items when the button is at one "
"end of the panel. It does not react to the mouse. In the middle of the panel "
"there is no gap: the button is twice as wide instead, with the line in the "
"center. With the glass shine, the button looks the same everywhere."
msgstr ""
"Espaço vazio entre o botão e os outros itens quando o botão está em uma "
"ponta do painel. Não reage ao mouse. No meio do painel não há espaço: em vez "
"disso, o botão fica duas vezes mais largo, com a linha no centro. Com o "
"brilho de vidro, o botão fica igual em qualquer lugar."

#: src/dialog.c:650
msgid "Gap at the panel _ends (px):"
msgstr "Espaço _nas pontas do painel (px):"

#: src/dialog.c:651
msgid "General"
msgstr "Geral"

#: src/dialog.c:660
msgid "_Icon:"
msgstr "Í_cone:"

#: src/dialog.c:664
msgid ""
"The button grows to fit the icon. The only limit is the height of the panel."
msgstr ""
"O botão aumenta para caber o ícone. O único limite é a altura do painel."

#: src/dialog.c:665
msgid "Icon si_ze (px):"
msgstr "T_amanho do ícone (px):"

#: src/dialog.c:667
msgid "_Follow the panel icon size"
msgstr "Seguir _o tamanho dos ícones do painel"

#: src/dialog.c:680
msgid "Cop_y"
msgstr "Cop_iar"

#: src/dialog.c:682
msgid "Replace all settings of this button with those of the selected one"
msgstr "Substitui todas as configurações deste botão pelas do selecionado"

#: src/dialog.c:686
msgid "Fro_m:"
msgstr "_De:"

#: src/dialog.c:690
msgid "Copy settings from another button"
msgstr "Copiar configurações de outro botão"

#: src/dialog.c:700
msgid "Line _width (px):"
msgstr "_Espessura da linha (px):"

#. TRANSLATORS: unit of the line length: percent of the panel height, or pixels
#: src/dialog.c:707
#, no-c-format
msgid "% of panel"
msgstr "% do painel"

#: src/dialog.c:707
msgid "px"
msgstr "px"

#: src/dialog.c:711
msgid "Line _length:"
msgstr "_Comprimento da linha:"

#: src/dialog.c:717
msgid "Start (left / top)"
msgstr "Início (esquerda / topo)"

#: src/dialog.c:717
msgid "Center"
msgstr "Centro"

#: src/dialog.c:717
msgid "End (right / bottom)"
msgstr "Fim (direita / base)"

#: src/dialog.c:718
msgid "Automatic (depends on where the button is)"
msgstr "Automática (depende de onde está o botão)"

#: src/dialog.c:720
msgid ""
"Automatic: at one end of the panel, the line faces the other items; in the "
"middle, it goes in the center."
msgstr ""
"Automática: em uma ponta do painel, a linha fica voltada para os outros "
"itens; no meio, fica no centro."

#: src/dialog.c:722
msgid "_Position:"
msgstr "_Posição:"

#: src/dialog.c:724
msgid "Always"
msgstr "Sempre"

#: src/dialog.c:724
msgid "Only on hover"
msgstr "Somente ao passar o mouse"

#: src/dialog.c:725
msgid "_Visible:"
msgstr "_Visível:"

#: src/dialog.c:728
msgid "C_olor:"
msgstr "C_or:"

#: src/dialog.c:731
msgid "Color on _hover:"
msgstr "Cor _ao passar o mouse:"

#: src/dialog.c:734
msgid "Color when p_ressed:"
msgstr "Cor ao p_ressionar:"

#: src/dialog.c:736
msgid "Rounded _ends"
msgstr "Po_ntas arredondadas"

#: src/dialog.c:743
msgid "Background"
msgstr "Fundo"

#: src/dialog.c:749
msgid "_Normal:"
msgstr "_Normal:"

#: src/dialog.c:752
msgid "On h_over:"
msgstr "Ao passar o _mouse:"

#: src/dialog.c:755
msgid "_Pressed:"
msgstr "_Pressionado:"

#: src/dialog.c:758
msgid "Corner _radius (px):"
msgstr "_Raio dos cantos (px):"

#: src/dialog.c:764
msgid "Small"
msgstr "Pequeno"

#: src/dialog.c:765
msgid "Full"
msgstr "Completo"

#: src/dialog.c:768
msgid "How much of the button the colored background covers"
msgstr "Quanto do botão o fundo colorido cobre"

#: src/dialog.c:769
msgid "_Size:"
msgstr "_Tamanho:"

#: src/dialog.c:771
msgid "_Glass shine"
msgstr "_Brilho de vidro"

#: src/dialog.c:775
msgid "_Keep the pressed color while the desktop is shown"
msgstr ""
"Manter _a cor de pressionado enquanto a área de trabalho estiver visível"

#: src/dialog.c:778
msgid "Background colors"
msgstr "Cores de fundo"

#: src/dialog.c:783
msgid "Smooth _transitions"
msgstr "Transições _suaves"

#: src/dialog.c:785
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Esmaece as cores ao passar o mouse e clicar, em vez de mudá-las "
"instantaneamente"

#: src/dialog.c:788
msgid "Fast"
msgstr "Rápida"

#: src/dialog.c:788
msgid "Normal"
msgstr "Normal"

#: src/dialog.c:788
msgid "Slow"
msgstr "Lenta"

#: src/dialog.c:789
msgid "Spee_d:"
msgstr "_Velocidade:"

#: src/dialog.c:791
msgid "Animations are disabled in the system settings."
msgstr "As animações estão desativadas nas configurações do sistema."

#: src/dialog.c:798
msgid "Animation"
msgstr "Animação"

#: src/dialog.c:801
msgid "Behavior"
msgstr "Comportamento"

#: src/dialog.c:805 src/dialog.c:817
msgid "Do nothing"
msgstr "Não fazer nada"

#: src/dialog.c:805
msgid "Show / restore desktop"
msgstr "Mostrar / restaurar área de trabalho"

#: src/dialog.c:806
msgid "Minimize all windows"
msgstr "Minimizar todas as janelas"

#: src/dialog.c:807
msgid "Shade / unshade windows (X11 only)"
msgstr "Enrolar / desenrolar janelas (somente X11)"

#: src/dialog.c:808
msgid "_Middle click:"
msgstr "Clique do _meio:"

#: src/dialog.c:810
msgid "Window shading is not supported on Wayland."
msgstr "Enrolar janelas não é suportado no Wayland."

#: src/dialog.c:817
msgid "Switch workspace"
msgstr "Alternar espaço de trabalho"

#: src/dialog.c:818
msgid "Up shows desktop, down restores"
msgstr "Para cima mostra a área de trabalho, para baixo restaura"

#: src/dialog.c:819
msgid "Mouse _wheel:"
msgstr "_Roda do mouse:"

#: src/dialog.c:821
msgid "Workspace switching is not available in this session."
msgstr "A troca de espaço de trabalho não está disponível nesta sessão."

#: src/dialog.c:828
msgid "Show desktop when _dragging a file over the button"
msgstr "Mostrar a área de trabalho ao _arrastar um arquivo sobre o botão"

#: src/dialog.c:832
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Cop_iar para a Área de Trabalho os arquivos soltos sobre o botão"

#: src/dialog.c:834
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo (2)."
"jpg\"."
msgstr ""
"Os arquivos originais nunca são movidos ou excluídos, e os arquivos "
"existentes na Área de Trabalho nunca são sobrescritos: a cópia recebe um "
"novo nome, como \"foto (2).jpg\"."

#: src/dialog.c:838
msgid "Show _tooltip"
msgstr "Mostrar _dica"

#: src/dialog.c:841
msgid "Actions"
msgstr "Ações"

#: src/dialog.c:848
msgid "Show the desktop while the mouse is _over the button"
msgstr "Mostrar a área de trabalho enquanto o mouse estiver s_obre o botão"

#: src/dialog.c:850
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep "
"the desktop visible."
msgstr ""
"Afastar o mouse restaura as janelas. Clique durante a espiada para manter a "
"área de trabalho visível."

#: src/dialog.c:855
msgid "D_elay (ms):"
msgstr "A_traso (ms):"

#: src/dialog.c:857
msgid "Peek"
msgstr "Espiada"

#: src/dialog.c:862
msgid ""
"Tip: place the button at one end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Dica: coloque o botão em uma ponta do painel e defina a margem do painel "
"como 0 para clicar nele empurrando o mouse até o canto da tela."

#: src/dialog.c:864
msgid "Keyboard shortcut command:"
msgstr "Comando para atalho de teclado:"

#: src/plugin.c:302
msgid "Show desktop is not available in this session"
msgstr "Mostrar a área de trabalho não está disponível nesta sessão"

#: src/plugin.c:304
msgid "Restore the minimized windows"
msgstr "Restaurar as janelas minimizadas"

#: src/plugin.c:306
msgid "Minimize all open windows and show the desktop"
msgstr "Minimizar todas as janelas abertas e mostrar a área de trabalho"

#: src/plugin.c:312
msgid "Show Desktop"
msgstr "Mostrar área de trabalho"

#: src/plugin.c:1035
msgid "_Minimize all windows"
msgstr "_Minimizar todas as janelas"

#: src/plugin.c:1041
msgid "S_hade / unshade windows"
msgstr "_Enrolar / desenrolar janelas"

#: src/plugin.c:1057
msgid "_Profile"
msgstr "_Perfil"

#: src/plugin.c:1086
msgid "A slim, customizable Show Desktop button"
msgstr "Um botão \"Mostrar área de trabalho\" fino e personalizável"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "Botão \"Mostrar área de trabalho\" fino e personalizável"
