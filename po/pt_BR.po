msgid "Icon"
msgstr "Ícone"

#: src/dialog.c:555
msgid "None (background only)"
msgstr "Nenhum (apenas fundo)"

#: src/dialog.c:556
msgid "_Style:"
msgstr "_Estilo:"

#: src/dialog.c:558
msgid "Use a single panel _row"
msgstr "Usar uma única _linha do painel"

#: src/dialog.c:560
msgid ""
"On panels with more than one row, the button takes up only one row instead of"
" the full height of the panel"
msgstr ""
"Em painéis com mais de uma linha, o botão ocupa só uma linha em vez de toda a"
" altura do painel"

#: src/dialog.c:563
msgid "General"
msgstr "Geral"

#: src/dialog.c:570
msgid "Icon _name:"
msgstr "_Nome do ícone:"

#: src/dialog.c:573
msgid "Icon si_ze (px):"
msgstr "_Tamanho do ícone (px):"

#: src/dialog.c:575
msgid "_Follow the panel icon size"
msgstr "_Seguir o tamanho dos ícones do painel"

#: src/dialog.c:588
msgid "C_opy"
msgstr "C_opiar"

#: src/dialog.c:590
msgid "Replace all settings of this button with those of the selected one"
msgstr "Substitui todas as configurações deste botão pelas do selecionado"

#: src/dialog.c:594
msgid "_From:"
msgstr "_De:"

#: src/dialog.c:598
msgid "Copy settings from another button"
msgstr "Copiar configurações de outro botão"

#: src/dialog.c:608
msgid "Line _width (px):"
msgstr "_Espessura da linha (px):"

