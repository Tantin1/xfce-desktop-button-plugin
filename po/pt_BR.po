msgstr "Início (esquerda / topo)"

#: src/dialog.c:624
msgid "Center"
msgstr "Centro"

#: src/dialog.c:624
msgid "End (right / bottom)"
msgstr "Fim (direita / base)"

#: src/dialog.c:625
msgid "_Position:"
msgstr "_Posição:"

#: src/dialog.c:627
msgid "Always"
msgstr "Sempre"

#: src/dialog.c:627
msgid "Only on hover"
msgstr "Somente ao passar o mouse"

#: src/dialog.c:628
msgid "_Visible:"
msgstr "_Visível:"

#: src/dialog.c:631
msgid "_Color:"
msgstr "_Cor:"

#: src/dialog.c:634
msgid "Color on _hover:"
msgstr "Cor ao _passar o mouse:"

#: src/dialog.c:637
msgid "Color when p_ressed:"
msgstr "Cor ao p_ressionar:"

#: src/dialog.c:639
msgid "R_ounded ends"
msgstr "Pontas a_rredondadas"

#: src/dialog.c:646
msgid "Background"
msgstr "Fundo"

#: src/dialog.c:652
msgid "_Normal:"
msgstr "_Normal:"

#: src/dialog.c:655
msgid "On h_over:"
msgstr "Ao passar o _mouse:"

#: src/dialog.c:658
msgid "_Pressed:"
msgstr "_Pressionado:"

#: src/dialog.c:661
msgid "Corner _radius (px):"
msgstr "_Raio dos cantos (px):"

#: src/dialog.c:665
msgid "Empty space between the edge of the button and the colored background"
msgstr "Espaço vazio entre a borda do botão e o fundo colorido"

#: src/dialog.c:666
msgid "_Margin (px):"
msgstr "_Margem (px):"

#: src/dialog.c:668
msgid "_Glass shine"
msgstr "_Brilho de vidro"

#: src/dialog.c:672
msgid "_Keep the pressed color while the desktop is shown"
msgstr ""
"_Manter a cor de pressionado enquanto a área de trabalho estiver visível"

#: src/dialog.c:675
msgid "Background colors"
msgstr "Cores de fundo"

#: src/dialog.c:680
msgid "Smooth _transitions"
msgstr "_Transições suaves"

#: src/dialog.c:682
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Esmaece as cores ao passar o mouse e clicar, em vez de mudá-las "
"instantaneamente"

#: src/dialog.c:685
msgid "Fast"
msgstr "Rápida"

#: src/dialog.c:685
msgid "Normal"
msgstr "Normal"

#: src/dialog.c:685
msgid "Slow"
msgstr "Lenta"

#: src/dialog.c:686
msgid "Spee_d:"
msgstr "_Velocidade:"

#: src/dialog.c:688
msgid "Animations are disabled in the system settings."
msgstr "As animações estão desativadas nas configurações do sistema."

#: src/dialog.c:695
msgid "Animation"
msgstr "Animação"

#: src/dialog.c:698
msgid "Behavior"
msgstr "Comportamento"

#: src/dialog.c:702 src/dialog.c:714
msgid "Do nothing"
msgstr "Não fazer nada"

#: src/dialog.c:702
msgid "Show / restore desktop"
msgstr "Mostrar / restaurar área de trabalho"

#: src/dialog.c:703
msgid "Minimize all windows"
msgstr "Minimizar todas as janelas"

#: src/dialog.c:704
msgid "Shade / unshade windows (X11 only)"
msgstr "Enrolar / desenrolar janelas (somente X11)"

#: src/dialog.c:705
msgid "_Middle click:"
msgstr "Clique do _meio:"

#: src/dialog.c:707
msgid "Window shading is not supported on Wayland."
msgstr "Enrolar janelas não é suportado no Wayland."

#: src/dialog.c:714
msgid "Switch workspace"
msgstr "Alternar espaço de trabalho"

#: src/dialog.c:715
msgid "Up shows desktop, down restores"
msgstr "Para cima mostra a área de trabalho, para baixo restaura"

#: src/dialog.c:716
msgid "Mouse _wheel:"
msgstr "_Roda do mouse:"

#: src/dialog.c:718
msgid "Workspace switching is not available in this session."
msgstr "A troca de espaço de trabalho não está disponível nesta sessão."

#: src/dialog.c:725
msgid "Show desktop when _dragging a file over the button"
msgstr "Mostrar a área de trabalho ao _arrastar um arquivo sobre o botão"

#: src/dialog.c:729
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Cop_iar para a Área de Trabalho os arquivos soltos sobre o botão"

#: src/dialog.c:731
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo "
"(2).jpg\"."
msgstr ""
"Os arquivos originais nunca são movidos ou excluídos, e os arquivos "
"existentes na Área de Trabalho nunca são sobrescritos: a cópia recebe um novo"
" nome, como \"foto (2).jpg\"."

#: src/dialog.c:735
msgid "Show _tooltip"
msgstr "Mostrar _dica"

#: src/dialog.c:738
msgid "Actions"
msgstr "Ações"

#: src/dialog.c:745
msgid "Show the desktop while the mouse is _over the button"
msgstr "Mostrar a área de trabalho enquanto o mouse estiver s_obre o botão"

#: src/dialog.c:747
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep the"
" desktop visible."
msgstr ""
"Afastar o mouse restaura as janelas. Clique durante a espiada para manter a "
"área de trabalho visível."

#: src/dialog.c:752
msgid "D_elay (ms):"
msgstr "_Atraso (ms):"

#: src/dialog.c:754
msgid "Peek"
msgstr "Espiada"

#: src/dialog.c:759
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Dica: coloque o botão no fim do painel e defina a margem do painel como 0 "
"para clicar nele empurrando o mouse até o canto da tela."

#: src/dialog.c:761
msgid "Keyboard shortcut command:"
msgstr "Comando para atalho de teclado:"

#: src/plugin.c:249
msgid "Show desktop is not available in this session"
msgstr "Mostrar a área de trabalho não está disponível nesta sessão"

#: src/plugin.c:251
msgid "Restore the minimized windows"
msgstr "Restaurar as janelas minimizadas"

#: src/plugin.c:253
msgid "Minimize all open windows and show the desktop"
msgstr "Minimizar todas as janelas abertas e mostrar a área de trabalho"

#: src/plugin.c:259
msgid "Show Desktop"
msgstr "Mostrar área de trabalho"

#: src/plugin.c:939
msgid "_Minimize all windows"
msgstr "_Minimizar todas as janelas"

#: src/plugin.c:945
msgid "S_hade / unshade windows"
msgstr "_Enrolar / desenrolar janelas"

#: src/plugin.c:961
msgid "_Profile"
msgstr "_Perfil"

#: src/plugin.c:990
msgid "A slim, customizable Show Desktop button"
msgstr "Um botão \"Mostrar área de trabalho\" fino e personalizável"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "Botão \"Mostrar área de trabalho\" fino e personalizável"
