msgid "Color when p_ressed:"
msgstr "Kleur bij _indrukken:"

#: src/dialog.c:639
msgid "R_ounded ends"
msgstr "Afgeronde _uiteinden"

#: src/dialog.c:646
msgid "Background"
msgstr "Achtergrond"

#: src/dialog.c:652
msgid "_Normal:"
msgstr "_Normaal:"

#: src/dialog.c:655
