msgid "_Position:"
msgstr "_Positie:"

#: src/dialog.c:627
msgid "Always"
msgstr "Altijd"

#: src/dialog.c:627
msgid "Only on hover"
msgstr "Alleen bij aanwijzen"

#: src/dialog.c:628
msgid "_Visible:"
msgstr "_Zichtbaar:"

