#: src/dialog.c:771
msgid "_Glass shine"
msgstr "G_lasglans"

#: src/dialog.c:775
msgid "_Keep the pressed color while the desktop is shown"
msgstr "Kleur bij indrukken _behouden zolang het bureaublad wordt getoond"

#: src/dialog.c:778
msgid "Background colors"
