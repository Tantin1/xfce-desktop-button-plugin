msgstr "Geen (alleen achtergrond)"

#: src/dialog.c:556
msgid "_Style:"
msgstr "_Stijl:"

#: src/dialog.c:558
msgid "Use a single panel _row"
msgstr "Slechts één paneel_rij gebruiken"

#: src/dialog.c:560
msgid ""
"On panels with more than one row, the button takes up only one row instead of"
" the full height of the panel"
msgstr ""
"Op panelen met meer dan één rij neemt de knop slechts één rij in beslag in "
"plaats van de volledige hoogte van het paneel"

#: src/dialog.c:563
msgid "General"
msgstr "Algemeen"

#: src/dialog.c:570
