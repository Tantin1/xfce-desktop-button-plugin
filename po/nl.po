#: src/dialog.c:783
msgid "Smooth _transitions"
msgstr "Vloeiende _overgangen"

#: src/dialog.c:785
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Kleuren laten overvloeien bij aanwijzen en klikken in plaats van ze direct "
"te wijzigen"

#: src/dialog.c:788
msgid "Fast"
msgstr "Snel"

#: src/dialog.c:788
