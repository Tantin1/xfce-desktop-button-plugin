msgid "_Pressed:"
msgstr "_Ingedrukt:"

#: src/dialog.c:661
msgid "Corner _radius (px):"
msgstr "Hoek_straal (px):"

#: src/dialog.c:665
msgid "Empty space between the edge of the button and the colored background"
msgstr "Lege ruimte tussen de rand van de knop en de gekleurde achtergrond"

#: src/dialog.c:666
msgid "_Margin (px):"
msgstr "_Marge (px):"

#: src/dialog.c:668
msgid "_Glass shine"
msgstr "_Glasglans"

#: src/dialog.c:672
msgid "_Keep the pressed color while the desktop is shown"
msgstr "Kleur bij indrukken _behouden zolang het bureaublad wordt getoond"

#: src/dialog.c:675
msgid "Background colors"
msgstr "Achtergrondkleuren"

#: src/dialog.c:680
msgid "Smooth _transitions"
msgstr "Vloeiende _overgangen"

#: src/dialog.c:682
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Kleuren laten overvloeien bij aanwijzen en klikken in plaats van ze direct te"
" wijzigen"

#: src/dialog.c:685
msgid "Fast"
msgstr "Snel"

#: src/dialog.c:685
msgid "Normal"
msgstr "Normaal"

#: src/dialog.c:685
msgid "Slow"
msgstr "Langzaam"

#: src/dialog.c:686
msgid "Spee_d:"
msgstr "_Snelheid:"

#: src/dialog.c:688
msgid "Animations are disabled in the system settings."
msgstr "Animaties zijn uitgeschakeld in de systeeminstellingen."

#: src/dialog.c:695
msgid "Animation"
msgstr "Animatie"

#: src/dialog.c:698
msgid "Behavior"
msgstr "Gedrag"

#: src/dialog.c:702 src/dialog.c:714
msgid "Do nothing"
msgstr "Niets doen"

#: src/dialog.c:702
msgid "Show / restore desktop"
msgstr "Bureaublad tonen / herstellen"

#: src/dialog.c:703
msgid "Minimize all windows"
msgstr "Alle vensters minimaliseren"

#: src/dialog.c:704
msgid "Shade / unshade windows (X11 only)"
msgstr "Vensters oprollen / uitrollen (alleen X11)"

#: src/dialog.c:705
msgid "_Middle click:"
msgstr "_Middelklik:"

#: src/dialog.c:707
msgid "Window shading is not supported on Wayland."
msgstr "Vensters oprollen wordt niet ondersteund op Wayland."

#: src/dialog.c:714
msgid "Switch workspace"
msgstr "Van werkblad wisselen"

#: src/dialog.c:715
msgid "Up shows desktop, down restores"
msgstr "Omhoog toont bureaublad, omlaag herstelt"

#: src/dialog.c:716
msgid "Mouse _wheel:"
msgstr "_Muiswiel:"

#: src/dialog.c:718
msgid "Workspace switching is not available in this session."
msgstr "Wisselen van werkblad is niet beschikbaar in deze sessie."

#: src/dialog.c:725
msgid "Show desktop when _dragging a file over the button"
msgstr "Bureaublad tonen bij het _slepen van een bestand over de knop"

#: src/dialog.c:729
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Op de knop neergezette bestanden naar het bureaublad _kopiëren"

#: src/dialog.c:731
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo "
"(2).jpg\"."
msgstr ""
"De originele bestanden worden nooit verplaatst of verwijderd en bestaande "
"bestanden op het bureaublad worden nooit overschreven: een kopie krijgt een "
"nieuwe naam, zoals \"foto (2).jpg\"."

#: src/dialog.c:735
msgid "Show _tooltip"
msgstr "_Tooltip tonen"

#: src/dialog.c:738
msgid "Actions"
msgstr "Acties"

#: src/dialog.c:745
msgid "Show the desktop while the mouse is _over the button"
msgstr "Bureaublad tonen zolang de muis _boven de knop is"

#: src/dialog.c:747
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep the"
" desktop visible."
msgstr ""
"Als de muis wordt weggehaald, worden de vensters hersteld. Klik tijdens het "
"kijkje om het bureaublad zichtbaar te houden."

#: src/dialog.c:752
msgid "D_elay (ms):"
msgstr "_Vertraging (ms):"

#: src/dialog.c:754
msgid "Peek"
msgstr "Kijkje"

#: src/dialog.c:759
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Tip: plaats de knop aan het einde van het paneel en zet de paneelmarge op 0, "
"zodat je erop kunt klikken door de muis in de schermhoek te duwen."

#: src/dialog.c:761
msgid "Keyboard shortcut command:"
msgstr "Commando voor een sneltoets:"

#: src/plugin.c:249
msgid "Show desktop is not available in this session"
msgstr "Bureaublad tonen is niet beschikbaar in deze sessie"

#: src/plugin.c:251
msgid "Restore the minimized windows"
msgstr "Geminimaliseerde vensters herstellen"

#: src/plugin.c:253
msgid "Minimize all open windows and show the desktop"
msgstr "Alle geopende vensters minimaliseren en het bureaublad tonen"

#: src/plugin.c:259
msgid "Show Desktop"
msgstr "Bureaublad tonen"

#: src/plugin.c:939
msgid "_Minimize all windows"
msgstr "Alle vensters _minimaliseren"

#: src/plugin.c:945
msgid "S_hade / unshade windows"
msgstr "Vensters _oprollen / uitrollen"

#: src/plugin.c:961
msgid "_Profile"
msgstr "_Profiel"

#: src/plugin.c:990
msgid "A slim, customizable Show Desktop button"
msgstr "Een smalle, aanpasbare knop om het bureaublad te tonen"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "Smalle, aanpasbare knop om het bureaublad te tonen"
