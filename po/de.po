msgid "_Keep the pressed color while the desktop is shown"
msgstr "Gedrückte Farbe _beibehalten, solange der Desktop angezeigt wird"

#: src/dialog.c:768
msgid "Background colors"
msgstr "Hintergrundfarben"

#: src/dialog.c:773
msgid "Smooth _transitions"
msgstr "_Weiche Übergänge"

#: src/dialog.c:775
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Farben beim Überfahren und Klicken überblenden, statt sie sofort zu wechseln"

#: src/dialog.c:778
msgid "Fast"
msgstr "Schnell"

#: src/dialog.c:778
msgid "Normal"
msgstr "Normal"

#: src/dialog.c:778
msgid "Slow"
msgstr "Langsam"

#: src/dialog.c:779
