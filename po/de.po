msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Farben beim Überfahren und Klicken überblenden, statt sie sofort zu wechseln"

#: src/dialog.c:676
msgid "Fast"
msgstr "Schnell"

#: src/dialog.c:676
msgid "Normal"
msgstr "Normal"

