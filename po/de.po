msgstr "Dunkel"

#: src/dialog.c:542
msgid "Light"
msgstr "Hell"

#: src/dialog.c:544
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr ""
"Die integrierten Profile verwenden Weiß auf dunklen und Schwarz auf hellen "
"Leisten"

#: src/dialog.c:545
msgid "Panel t_one:"
msgstr "_Farbton der Leiste:"

