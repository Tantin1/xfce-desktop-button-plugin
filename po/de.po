msgid "Line"
msgstr "Linie"

#: src/dialog.c:555 src/dialog.c:578
msgid "Icon"
msgstr "Symbol"

#: src/dialog.c:555
msgid "None (background only)"
msgstr "Keines (nur Hintergrund)"

#: src/dialog.c:556
msgid "_Style:"
msgstr "_Stil:"

#: src/dialog.c:558
msgid "Use a single panel _row"
msgstr "Nur eine Leisten_zeile verwenden"

#: src/dialog.c:560
msgid ""
"On panels with more than one row, the button takes up only one row instead of"
" the full height of the panel"
msgstr ""
"Bei Leisten mit mehreren Zeilen belegt die Schaltfläche nur eine Zeile statt "
"der gesamten Höhe der Leiste"

#: src/dialog.c:563
msgid "General"
msgstr "Allgemein"

#: src/dialog.c:570
msgid "Icon _name:"
msgstr "Symbol_name:"

#: src/dialog.c:573
msgid "Icon si_ze (px):"
msgstr "Symbol_größe (px):"

#: src/dialog.c:575
msgid "_Follow the panel icon size"
msgstr "Symbolgröße der Leiste _übernehmen"

#: src/dialog.c:588
msgid "C_opy"
msgstr "_Kopieren"

#: src/dialog.c:590
msgid "Replace all settings of this button with those of the selected one"
msgstr ""
"Alle Einstellungen dieser Schaltfläche durch die der ausgewählten ersetzen"

#: src/dialog.c:594
msgid "_From:"
msgstr "_Von:"

#: src/dialog.c:598
msgid "Copy settings from another button"
msgstr "Einstellungen von einer anderen Schaltfläche kopieren"

#: src/dialog.c:608
msgid "Line _width (px):"
msgstr "Linien_stärke (px):"

#. TRANSLATORS: unit of the line length: percent of the panel height, or pixels
#: src/dialog.c:615
#, no-c-format
