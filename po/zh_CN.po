msgid "Background"
msgstr "背景"

#: src/dialog.c:739
msgid "_Normal:"
msgstr "正常(_N)："

#: src/dialog.c:742
msgid "On h_over:"
msgstr "悬停时(_O)："

#: src/dialog.c:745
msgid "_Pressed:"
msgstr "按下时(_P)："

