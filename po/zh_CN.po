msgid "_Profile:"
msgstr "配置方案(_P)："

#: src/dialog.c:542
msgid "Automatic"
msgstr "自动"

#: src/dialog.c:542
msgid "Dark"
msgstr "深色"

#: src/dialog.c:542
msgid "Light"
msgstr "浅色"

#: src/dialog.c:544
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr "内置方案在深色面板上使用白色，在浅色面板上使用黑色"

#: src/dialog.c:545
msgid "Panel t_one:"
msgstr "面板色调(_O)："

