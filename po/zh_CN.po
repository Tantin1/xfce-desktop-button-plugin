msgid "_Glass shine"
msgstr "玻璃光泽(_G)"

#: src/dialog.c:663
msgid "_Keep the pressed color while the desktop is shown"
msgstr "显示桌面时保持按下颜色(_K)"

#: src/dialog.c:666
msgid "Background colors"
msgstr "背景颜色"

#: src/dialog.c:671
msgid "Smooth _transitions"
msgstr "平滑过渡(_T)"

#: src/dialog.c:673
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr "悬停和点击时渐变颜色，而不是立即切换"

#: src/dialog.c:676
msgid "Fast"
msgstr "快"

#: src/dialog.c:676
msgid "Normal"
msgstr "正常"

#: src/dialog.c:676
msgid "Slow"
msgstr "慢"

#: src/dialog.c:677
msgid "Spee_d:"
msgstr "速度(_D)："

#: src/dialog.c:679
msgid "Animations are disabled in the system settings."
msgstr "系统设置中已禁用动画。"

#: src/dialog.c:686
msgid "Animation"
msgstr "动画"

#: src/dialog.c:689
msgid "Behavior"
msgstr "行为"

#: src/dialog.c:693 src/dialog.c:705
msgid "Do nothing"
msgstr "不执行任何操作"

#: src/dialog.c:693
msgid "Show / restore desktop"
msgstr "显示 / 恢复桌面"

#: src/dialog.c:694
msgid "Minimize all windows"
msgstr "最小化所有窗口"

#: src/dialog.c:695
msgid "Shade / unshade windows (X11 only)"
msgstr "卷起 / 展开窗口（仅 X11）"

#: src/dialog.c:696
msgid "_Middle click:"
msgstr "中键单击(_M)："

#: src/dialog.c:698
msgid "Window shading is not supported on Wayland."
msgstr "Wayland 不支持卷起窗口。"

#: src/dialog.c:705
msgid "Switch workspace"
msgstr "切换工作区"

#: src/dialog.c:706
msgid "Up shows desktop, down restores"
msgstr "向上显示桌面，向下恢复"

#: src/dialog.c:707
msgid "Mouse _wheel:"
msgstr "鼠标滚轮(_W)："

#: src/dialog.c:709
msgid "Workspace switching is not available in this session."
msgstr "此会话中无法切换工作区。"

#: src/dialog.c:716
msgid "Show desktop when _dragging a file over the button"
msgstr "将文件拖到按钮上时显示桌面(_D)"

#: src/dialog.c:720
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "将拖放到按钮上的文件复制到桌面(_Y)"

#: src/dialog.c:722
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo "
"(2).jpg\"."
msgstr "原始文件绝不会被移动或删除，桌面上已有的文件也绝不会被覆盖：副本会得到新名称，例如“photo (2).jpg”。"

#: src/dialog.c:726
msgid "Show _tooltip"
msgstr "显示工具提示(_T)"

#: src/dialog.c:729
msgid "Actions"
msgstr "操作"

#: src/dialog.c:736
msgid "Show the desktop while the mouse is _over the button"
msgstr "鼠标位于按钮上时显示桌面(_O)"

#: src/dialog.c:738
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep the"
" desktop visible."
msgstr "移开鼠标即可恢复窗口。在预览期间单击可使桌面保持可见。"

#: src/dialog.c:743
msgid "D_elay (ms):"
msgstr "延迟(_E)（毫秒）："

#: src/dialog.c:745
msgid "Peek"
msgstr "预览"

#: src/dialog.c:750
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr "提示：将按钮放在面板末端并把面板边距设为 0，即可将鼠标推到屏幕角落来点击它。"

#: src/dialog.c:752
msgid "Keyboard shortcut command:"
msgstr "键盘快捷键命令："

#: src/plugin.c:243
msgid "Show desktop is not available in this session"
msgstr "此会话中无法显示桌面"

#: src/plugin.c:245
msgid "Restore the minimized windows"
msgstr "恢复已最小化的窗口"

#: src/plugin.c:247
msgid "Minimize all open windows and show the desktop"
msgstr "最小化所有打开的窗口并显示桌面"

#: src/plugin.c:253
msgid "Show Desktop"
msgstr "显示桌面"

#: src/plugin.c:933
msgid "_Minimize all windows"
msgstr "最小化所有窗口(_M)"

#: src/plugin.c:939
msgid "S_hade / unshade windows"
msgstr "卷起 / 展开窗口(_H)"

#: src/plugin.c:955
msgid "_Profile"
msgstr "配置方案(_P)"

#: src/plugin.c:984
msgid "A slim, customizable Show Desktop button"
msgstr "纤细且可自定义的“显示桌面”按钮"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "纤细且可自定义的“显示桌面”按钮"
