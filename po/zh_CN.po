msgid "Icon"
msgstr "图标"

#: src/dialog.c:555
msgid "None (background only)"
msgstr "无（仅背景）"

#: src/dialog.c:556
msgid "_Style:"
msgstr "样式(_S)："

#: src/dialog.c:558
msgid "Use a single panel _row"
msgstr "仅使用面板的一行(_R)"

#: src/dialog.c:560
msgid ""
"On panels with more than one row, the button takes up only one row instead "
"of the full height of the panel"
msgstr "在多行面板中，按钮只占一行，而不是占满面板的整个高度"

#: src/dialog.c:563
msgid "General"
msgstr "常规"

#: src/dialog.c:570
msgid "Icon _name:"
msgstr "图标名称(_N)："

