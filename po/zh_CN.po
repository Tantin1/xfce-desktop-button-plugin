msgid "Icon si_ze (px):"
msgstr "图标大小(_Z)（像素）："

#: src/dialog.c:575
msgid "_Follow the panel icon size"
msgstr "跟随面板图标大小(_F)"

#: src/dialog.c:588
msgid "C_opy"
msgstr "复制(_O)"

#: src/dialog.c:590
msgid "Replace all settings of this button with those of the selected one"
msgstr "用所选按钮的设置替换此按钮的全部设置"

#: src/dialog.c:594
msgid "_From:"
msgstr "来源(_F)："

#: src/dialog.c:598
msgid "Copy settings from another button"
msgstr "从其他按钮复制设置"

#: src/dialog.c:608
msgid "Line _width (px):"
msgstr "线条粗细(_W)（像素）："

#. TRANSLATORS: unit of the line length: percent of the panel height, or pixels
#: src/dialog.c:615
#, no-c-format
msgid "% of panel"
msgstr "面板的 %"

#: src/dialog.c:615
msgid "px"
msgstr "像素"

#: src/dialog.c:619
msgid "Line _length:"
msgstr "线条长度(_L)："

#: src/dialog.c:625
msgid "Start (left / top)"
msgstr "起始（左 / 上）"

#: src/dialog.c:625
msgid "Center"
msgstr "居中"

#: src/dialog.c:625
msgid "End (right / bottom)"
msgstr "末端（右 / 下）"

#: src/dialog.c:626
msgid "Automatic (toward the other panel items)"
msgstr "自动（朝向面板中的其他项目）"

#: src/dialog.c:627
msgid "_Position:"
msgstr "位置(_P)："

#: src/dialog.c:629
msgid "Always"
msgstr "始终"

#: src/dialog.c:629
msgid "Only on hover"
msgstr "仅在悬停时"

#: src/dialog.c:630
msgid "_Visible:"
msgstr "显示(_V)："

#: src/dialog.c:633
msgid "_Color:"
msgstr "颜色(_C)："

#: src/dialog.c:636
msgid "Color on _hover:"
msgstr "悬停时颜色(_H)："

#: src/dialog.c:639
msgid "Color when p_ressed:"
msgstr "按下时颜色(_R)："

#: src/dialog.c:641
msgid "R_ounded ends"
msgstr "圆角端点(_O)"

#: src/dialog.c:648
msgid "Background"
msgstr "背景"

#: src/dialog.c:654
msgid "_Normal:"
msgstr "正常(_N)："

#: src/dialog.c:657
msgid "On h_over:"
msgstr "悬停时(_O)："

#: src/dialog.c:660
msgid "_Pressed:"
msgstr "按下时(_P)："

#: src/dialog.c:663
msgid "Corner _radius (px):"
msgstr "圆角半径(_R)（像素）："

#: src/dialog.c:667
msgid "Empty space between the edge of the button and the colored background"
msgstr "按钮边缘与彩色背景之间的空白"

#: src/dialog.c:668
msgid "_Margin (px):"
msgstr "边距(_M)（像素）："

#: src/dialog.c:670
msgid "_Glass shine"
msgstr "玻璃光泽(_G)"

#: src/dialog.c:674
msgid "_Keep the pressed color while the desktop is shown"
msgstr "显示桌面时保持按下颜色(_K)"

#: src/dialog.c:677
msgid "Background colors"
msgstr "背景颜色"

#: src/dialog.c:682
msgid "Smooth _transitions"
msgstr "平滑过渡(_T)"

#: src/dialog.c:684
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr "悬停和点击时渐变颜色，而不是立即切换"

#: src/dialog.c:687
msgid "Fast"
msgstr "快"

#: src/dialog.c:687
msgid "Normal"
msgstr "正常"

#: src/dialog.c:687
msgid "Slow"
msgstr "慢"

#: src/dialog.c:688
msgid "Spee_d:"
msgstr "速度(_D)："

#: src/dialog.c:690
msgid "Animations are disabled in the system settings."
msgstr "系统设置中已禁用动画。"

#: src/dialog.c:697
msgid "Animation"
msgstr "动画"

#: src/dialog.c:700
msgid "Behavior"
msgstr "行为"

#: src/dialog.c:704 src/dialog.c:716
msgid "Do nothing"
msgstr "不执行任何操作"

#: src/dialog.c:704
msgid "Show / restore desktop"
msgstr "显示 / 恢复桌面"

#: src/dialog.c:705
msgid "Minimize all windows"
msgstr "最小化所有窗口"

#: src/dialog.c:706
msgid "Shade / unshade windows (X11 only)"
msgstr "卷起 / 展开窗口（仅 X11）"

#: src/dialog.c:707
msgid "_Middle click:"
msgstr "中键单击(_M)："

#: src/dialog.c:709
msgid "Window shading is not supported on Wayland."
msgstr "Wayland 不支持卷起窗口。"

#: src/dialog.c:716
msgid "Switch workspace"
msgstr "切换工作区"

#: src/dialog.c:717
msgid "Up shows desktop, down restores"
msgstr "向上显示桌面，向下恢复"

#: src/dialog.c:718
msgid "Mouse _wheel:"
msgstr "鼠标滚轮(_W)："

#: src/dialog.c:720
msgid "Workspace switching is not available in this session."
msgstr "此会话中无法切换工作区。"

#: src/dialog.c:727
msgid "Show desktop when _dragging a file over the button"
msgstr "将文件拖到按钮上时显示桌面(_D)"

#: src/dialog.c:731
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "将拖放到按钮上的文件复制到桌面(_Y)"

#: src/dialog.c:733
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo (2)."
"jpg\"."
msgstr ""
"原始文件绝不会被移动或删除，桌面上已有的文件也绝不会被覆盖：副本会得到新名"
"称，例如“photo (2).jpg”。"

#: src/dialog.c:737
msgid "Show _tooltip"
msgstr "显示工具提示(_T)"

#: src/dialog.c:740
msgid "Actions"
msgstr "操作"

#: src/dialog.c:747
msgid "Show the desktop while the mouse is _over the button"
msgstr "鼠标位于按钮上时显示桌面(_O)"

#: src/dialog.c:749
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep "
"the desktop visible."
msgstr "移开鼠标即可恢复窗口。在预览期间单击可使桌面保持可见。"

#: src/dialog.c:754
msgid "D_elay (ms):"
msgstr "延迟(_E)（毫秒）："

#: src/dialog.c:756
msgid "Peek"
msgstr "预览"

#: src/dialog.c:761
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"提示：将按钮放在面板末端并把面板边距设为 0，即可将鼠标推到屏幕角落来点击它。"

#: src/dialog.c:763
msgid "Keyboard shortcut command:"
msgstr "键盘快捷键命令："

#: src/plugin.c:287
msgid "Show desktop is not available in this session"
msgstr "此会话中无法显示桌面"

#: src/plugin.c:289
msgid "Restore the minimized windows"
msgstr "恢复已最小化的窗口"

#: src/plugin.c:291
msgid "Minimize all open windows and show the desktop"
msgstr "最小化所有打开的窗口并显示桌面"

#: src/plugin.c:297
msgid "Show Desktop"
msgstr "显示桌面"

#: src/plugin.c:1000
msgid "_Minimize all windows"
msgstr "最小化所有窗口(_M)"

#: src/plugin.c:1006
msgid "S_hade / unshade windows"
msgstr "卷起 / 展开窗口(_H)"

#: src/plugin.c:1022
msgid "_Profile"
msgstr "配置方案(_P)"

#: src/plugin.c:1051
msgid "A slim, customizable Show Desktop button"
msgstr "纤细且可自定义的“显示桌面”按钮"

#: src/xfce-desktop-button-plugin.desktop.in:5
msgid "Slim, customizable Show Desktop button"
msgstr "纤细且可自定义的“显示桌面”按钮"
