msgstr "深色"

#: src/dialog.c:617
msgid "Light"
msgstr "浅色"

#: src/dialog.c:619
msgid "Built-in profiles use white on dark panels and black on light panels"
msgstr "内置方案在深色面板上使用白色，在浅色面板上使用黑色"

#: src/dialog.c:620
msgid "Panel t_one:"
msgstr "面板色调(_O)："

