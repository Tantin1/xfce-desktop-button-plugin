#: src/dialog.c:758
msgid "Corner _radius (px):"
msgstr "_Radio de las esquinas (px):"

#: src/dialog.c:764
msgid "Small"
msgstr "Chico"

#: src/dialog.c:765
msgid "Full"
msgstr "Completo"

#: src/dialog.c:768
msgid "How much of the button the colored background covers"
msgstr "Cuánto del botón cubre el fondo de color"

#: src/dialog.c:769
msgid "_Size:"
msgstr "Tam_año:"

#: src/dialog.c:771
msgid "_Glass shine"
msgstr "_Brillo de vidrio"

#: src/dialog.c:775
msgid "_Keep the pressed color while the desktop is shown"
msgstr "_Mantener el color de presionado mientras se muestra el escritorio"

#: src/dialog.c:778
msgid "Background colors"
msgstr "Colores de fondo"

#: src/dialog.c:783
msgid "Smooth _transitions"
msgstr "Transiciones _suaves"

#: src/dialog.c:785
msgid ""
"Fade colors when hovering and clicking instead of changing them instantly"
msgstr ""
"Funde los colores al pasar el puntero y al hacer clic, en lugar de "
"cambiarlos de golpe"

#: src/dialog.c:788
msgid "Fast"
msgstr "Rápida"

#: src/dialog.c:788
msgid "Normal"
msgstr "Normal"

#: src/dialog.c:788
msgid "Slow"
msgstr "Lenta"

#: src/dialog.c:789
msgid "Spee_d:"
msgstr "_Velocidad:"

#: src/dialog.c:791
msgid "Animations are disabled in the system settings."
msgstr "Las animaciones están desactivadas en la configuración del sistema."

#: src/dialog.c:798
msgid "Animation"
msgstr "Animación"

#: src/dialog.c:801
msgid "Behavior"
msgstr "Comportamiento"

#: src/dialog.c:805 src/dialog.c:817
msgid "Do nothing"
msgstr "No hacer nada"

#: src/dialog.c:805
msgid "Show / restore desktop"
msgstr "Mostrar / restaurar el escritorio"

#: src/dialog.c:806
msgid "Minimize all windows"
msgstr "Minimizar todas las ventanas"

#: src/dialog.c:807
msgid "Shade / unshade windows (X11 only)"
msgstr "Enrollar / desenrollar ventanas (solo X11)"

#: src/dialog.c:808
msgid "_Middle click:"
msgstr "C_lic central:"

#: src/dialog.c:810
msgid "Window shading is not supported on Wayland."
msgstr "Enrollar ventanas no es compatible con Wayland."

#: src/dialog.c:817
msgid "Switch workspace"
msgstr "Cambiar de área de trabajo"

#: src/dialog.c:818
msgid "Up shows desktop, down restores"
msgstr "Arriba muestra el escritorio, abajo restaura"

#: src/dialog.c:819
msgid "Mouse _wheel:"
msgstr "_Rueda del ratón:"

#: src/dialog.c:821
msgid "Workspace switching is not available in this session."
msgstr "Cambiar de área de trabajo no está disponible en esta sesión."

#: src/dialog.c:828
msgid "Show desktop when _dragging a file over the button"
msgstr "Mostrar el escritorio al _arrastrar un archivo sobre el botón"

#: src/dialog.c:832
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Cop_iar al Escritorio los archivos soltados sobre el botón"

#: src/dialog.c:834
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo (2)."
"jpg\"."
msgstr ""
"Los archivos originales nunca se mueven ni se borran, y los archivos del "
"Escritorio nunca se sobrescriben: la copia recibe un nombre nuevo, como "
"«foto (2).jpg»."

#: src/dialog.c:838
msgid "Show _tooltip"
msgstr "_Mostrar información emergente"

#: src/dialog.c:841
msgid "Actions"
msgstr "Acciones"

#: src/dialog.c:848
msgid "Show the desktop while the mouse is _over the button"
msgstr "Mostrar el escritorio mientras el puntero esté s_obre el botón"

#: src/dialog.c:850
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep "
"the desktop visible."
msgstr ""
"Al alejar el puntero se restauran las ventanas. Un clic durante la vista "
"previa deja el escritorio visible."

#: src/dialog.c:855
msgid "D_elay (ms):"
msgstr "R_etardo (ms):"

#: src/dialog.c:857
msgid "Peek"
msgstr "Vista previa"

#: src/dialog.c:862
msgid ""
"Tip: place the button at one end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Consejo: ponga el botón en un extremo del panel y ajuste el margen del panel "
"a 0 para poder pulsarlo llevando el puntero a la esquina de la pantalla."

#: src/dialog.c:864
msgid "Keyboard shortcut command:"
msgstr "Comando para un atajo de teclado:"

#: src/plugin.c:302
msgid "Show desktop is not available in this session"
msgstr "Mostrar el escritorio no está disponible en esta sesión"

#: src/plugin.c:304
msgid "Restore the minimized windows"
msgstr "Restaurar las ventanas minimizadas"

#: src/plugin.c:306
msgid "Minimize all open windows and show the desktop"
msgstr "Minimizar todas las ventanas abiertas y mostrar el escritorio"

#: src/plugin.c:312
msgid "Show Desktop"
msgstr "Mostrar escritorio"

#: src/plugin.c:1035
msgid "_Minimize all windows"
msgstr "_Minimizar todas las ventanas"

#: src/plugin.c:1041
msgid "S_hade / unshade windows"
msgstr "_Enrollar / desenrollar ventanas"

#: src/plugin.c:1057
msgid "_Profile"
msgstr "_Perfil"

#: src/plugin.c:1086
msgid "A slim, customizable Show Desktop button"
msgstr "Un botón «Mostrar escritorio» delgado y personalizable"

#: src/xfce-desktop-button-plugin.desktop.in:5
