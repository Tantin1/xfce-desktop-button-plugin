#: src/dialog.c:795 src/dialog.c:807
msgid "Do nothing"
msgstr "No hacer nada"

#: src/dialog.c:795
msgid "Show / restore desktop"
msgstr "Mostrar / restaurar el escritorio"

#: src/dialog.c:796
msgid "Minimize all windows"
msgstr "Minimizar todas las ventanas"

#: src/dialog.c:797
msgid "Shade / unshade windows (X11 only)"
msgstr "Enrollar / desenrollar ventanas (solo X11)"

#: src/dialog.c:798
msgid "_Middle click:"
msgstr "Clic _central:"

#: src/dialog.c:800
msgid "Window shading is not supported on Wayland."
msgstr "Enrollar ventanas no es compatible con Wayland."

#: src/dialog.c:807
msgid "Switch workspace"
msgstr "Cambiar de área de trabajo"

#: src/dialog.c:808
msgid "Up shows desktop, down restores"
msgstr "Arriba muestra el escritorio, abajo restaura"

#: src/dialog.c:809
msgid "Mouse _wheel:"
msgstr "_Rueda del ratón:"

#: src/dialog.c:811
msgid "Workspace switching is not available in this session."
msgstr "Cambiar de área de trabajo no está disponible en esta sesión."

#: src/dialog.c:818
msgid "Show desktop when _dragging a file over the button"
msgstr "Mostrar el escritorio al _arrastrar un archivo sobre el botón"

#: src/dialog.c:822
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Cop_iar al Escritorio los archivos soltados sobre el botón"

#: src/dialog.c:824
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo (2)."
"jpg\"."
msgstr ""
"Los archivos originales nunca se mueven ni se borran, y los archivos del "
"Escritorio nunca se sobrescriben: la copia recibe un nombre nuevo, como "
"«foto (2).jpg»."

#: src/dialog.c:828
msgid "Show _tooltip"
msgstr "Mostrar _información emergente"

#: src/dialog.c:831
msgid "Actions"
msgstr "Acciones"

#: src/dialog.c:838
msgid "Show the desktop while the mouse is _over the button"
msgstr "Mostrar el escritorio mientras el puntero esté s_obre el botón"

#: src/dialog.c:840
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep "
"the desktop visible."
msgstr ""
"Al alejar el puntero se restauran las ventanas. Un clic durante la vista "
"previa deja el escritorio visible."

#: src/dialog.c:845
msgid "D_elay (ms):"
msgstr "_Retardo (ms):"

#: src/dialog.c:847
msgid "Peek"
msgstr "Vista previa"

#: src/dialog.c:852
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"Consejo: ponga el botón al final del panel y ajuste el margen del panel a 0 "
"para poder pulsarlo llevando el puntero a la esquina de la pantalla."

#: src/dialog.c:854
msgid "Keyboard shortcut command:"
msgstr "Comando para un atajo de teclado:"

#: src/plugin.c:290
msgid "Show desktop is not available in this session"
msgstr "Mostrar el escritorio no está disponible en esta sesión"

#: src/plugin.c:292
msgid "Restore the minimized windows"
msgstr "Restaurar las ventanas minimizadas"

#: src/plugin.c:294
msgid "Minimize all open windows and show the desktop"
msgstr "Minimizar todas las ventanas abiertas y mostrar el escritorio"

#: src/plugin.c:300
