msgstr "C_olor:"

#: src/dialog.c:731
msgid "Color on _hover:"
msgstr "Color _al pasar el puntero:"

#: src/dialog.c:734
msgid "Color when p_ressed:"
msgstr "Color al p_resionar:"

#: src/dialog.c:736
msgid "Rounded _ends"
msgstr "_Extremos redondeados"

#: src/dialog.c:743
msgid "Background"
msgstr "Fondo"

#: src/dialog.c:749
msgid "_Normal:"
msgstr "_Normal:"

#: src/dialog.c:752
