msgid "Animation"
msgstr "Animasyon"

#: src/dialog.c:698
msgid "Behavior"
msgstr "Davranış"

#: src/dialog.c:702 src/dialog.c:714
msgid "Do nothing"
msgstr "Hiçbir şey yapma"

#: src/dialog.c:702
msgid "Show / restore desktop"
msgstr "Masaüstünü göster / geri yükle"

#: src/dialog.c:703
msgid "Minimize all windows"
msgstr "Tüm pencereleri küçült"

#: src/dialog.c:704
msgid "Shade / unshade windows (X11 only)"
msgstr "Pencereleri tavana sar / aç (yalnızca X11)"

#: src/dialog.c:705
msgid "_Middle click:"
msgstr "_Orta tık:"

#: src/dialog.c:707
msgid "Window shading is not supported on Wayland."
msgstr "Pencereleri tavana sarma Wayland'de desteklenmiyor."

#: src/dialog.c:714
msgid "Switch workspace"
msgstr "Çalışma alanını değiştir"

#: src/dialog.c:715
msgid "Up shows desktop, down restores"
msgstr "Yukarı masaüstünü gösterir, aşağı geri yükler"

#: src/dialog.c:716
msgid "Mouse _wheel:"
msgstr "Fare _tekerleği:"

#: src/dialog.c:718
msgid "Workspace switching is not available in this session."
msgstr "Bu oturumda çalışma alanı değiştirme kullanılamıyor."

#: src/dialog.c:725
msgid "Show desktop when _dragging a file over the button"
msgstr "Düğmenin üzerine dosya _sürüklenince masaüstünü göster"

#: src/dialog.c:729
msgid "Cop_y files dropped on the button to the Desktop"
msgstr "Düğmeye bırakılan dosyaları Masaüstüne _kopyala"

#: src/dialog.c:731
msgid ""
"The original files are never moved or deleted, and existing files on the "
"Desktop are never overwritten: a copy gets a new name such as \"photo "
"(2).jpg\"."
msgstr ""
"Özgün dosyalar asla taşınmaz veya silinmez, Masaüstündeki mevcut dosyaların "
"üzerine asla yazılmaz: kopya \"fotoğraf (2).jpg\" gibi yeni bir ad alır."

#: src/dialog.c:735
msgid "Show _tooltip"
msgstr "_İpucunu göster"

#: src/dialog.c:738
msgid "Actions"
msgstr "Eylemler"

#: src/dialog.c:745
msgid "Show the desktop while the mouse is _over the button"
msgstr "Fare düğmenin _üzerindeyken masaüstünü göster"

#: src/dialog.c:747
msgid ""
"Moving the mouse away restores the windows. Click during the peek to keep the"
" desktop visible."
msgstr ""
"Fare uzaklaştırılınca pencereler geri yüklenir. Masaüstünün görünür kalması "
"için önizleme sırasında tıklayın."

#: src/dialog.c:752
msgid "D_elay (ms):"
msgstr "_Gecikme (ms):"

#: src/dialog.c:754
msgid "Peek"
msgstr "Önizleme"

#: src/dialog.c:759
msgid ""
"Tip: place the button at the end of the panel and set the panel margin to 0 "
"so you can click it by pushing the mouse into the screen corner."
msgstr ""
"İpucu: Düğmeyi panelin sonuna yerleştirip panel kenar boşluğunu 0 yaparsanız "
"fareyi ekranın köşesine iterek tıklayabilirsiniz."

#: src/dialog.c:761
msgid "Keyboard shortcut command:"
msgstr "Klavye kısayolu komutu:"

#: src/plugin.c:249
msgid "Show desktop is not available in this session"
msgstr "Bu oturumda masaüstünü gösterme kullanılamıyor"

#: src/plugin.c:251
msgid "Restore the minimized windows"
msgstr "Küçültülmüş pencereleri geri yükle"

#: src/plugin.c:253
msgid "Minimize all open windows and show the desktop"
msgstr "Tüm açık pencereleri küçült ve masaüstünü göster"

#: src/plugin.c:259
