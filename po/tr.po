msgstr "Başlangıç (sol / üst)"

#: src/dialog.c:717
msgid "Center"
msgstr "Orta"

#: src/dialog.c:717
msgid "End (right / bottom)"
msgstr "Bitiş (sağ / alt)"

#: src/dialog.c:718
msgid "Automatic (depends on where the button is)"
msgstr "Otomatik (düğmenin konumuna göre)"

#: src/dialog.c:720
msgid ""
"Automatic: at one end of the panel, the line faces the other items; in the "
"middle, it goes in the center."
msgstr ""
"Otomatik: panelin bir ucunda çizgi diğer öğelere doğru bakar; ortada ise "
"ortalanır."

